@page "/checkin/{Code}"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject AttendanceService AttendanceSvc
@inject AuthenticationStateProvider Auth
@inject ThemeService ThemeSvc

@* Landing page for a session's check-in QR code. Signed-in guests and staff are checked in on
   arrival; anyone else is sent to /join or /login and brought back here afterwards. Blazor
   Server runs OnInitializedAsync twice (prerender + circuit); the insert is idempotent, so the
   second run just reports "already checked in" and the page shows success either way. *@

<PageTitle>Check In — HBDA Events</PageTitle>

<div class="ccn-panel"
     style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(380px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow-y:auto;padding:24px;text-align:center;box-sizing:border-box">

    @if (_loading)
    {
        <div style="font-family:'Fredoka One',cursive;font-size:18px">Checking you in…</div>
    }
    else if (_item is null)
    {
        <div style="font-size:40px;line-height:1">🤔</div>
        <div style="font-family:'Fredoka One',cursive;font-size:20px;margin:8px 0">This check-in code isn't valid</div>
        <div style="font-size:13px;color:var(--text-mid)">It may have been replaced with a new one. Ask a staff member for the current QR code.</div>
    }
    else
    {
        <div style="font-size:12px;font-weight:700;color:var(--text-light)">@_item.CampEvent.Name</div>
        <div style="font-family:'Fredoka One',cursive;font-size:22px;color:var(--black);margin:2px 0 2px;line-height:1.2">@_item.Title</div>
        <div style="font-size:13px;color:var(--text-mid);font-weight:700;margin-bottom:16px">@_item.CampDay.ToString("dddd, MMM d") · @TimeRange(_item)</div>

        @if (!_signedIn)
        {
            <div style="font-size:14px;margin-bottom:14px">Sign in to check in.</div>
            <div style="display:flex;flex-direction:column;gap:10px">
                <a class="ccn-btn" href="@JoinUrl" style="text-decoration:none;padding:11px;font-size:16px;background:var(--color-primary);border:3px solid var(--black);box-shadow:4px 4px 0 var(--black)">I'm a guest</a>
                <a class="ccn-btn" href="@LoginUrl" style="text-decoration:none;padding:9px;font-size:14px;background:transparent">Staff sign in</a>
            </div>
        }
        else
        {
            switch (_result)
            {
                case CheckInResult.CheckedIn:
                case CheckInResult.AlreadyCheckedIn:
                    <div style="width:84px;height:84px;margin:0 auto 10px;border-radius:50%;background:#27AE60;border:3px solid var(--black);box-shadow:4px 4px 0 var(--black);display:flex;align-items:center;justify-content:center;font-size:44px;color:white;animation:popIn .3s ease">✓</div>
                    <div style="font-family:'Fredoka One',cursive;font-size:22px;color:#1E7F46">You're checked in!</div>
                    @if (_checkedInAt is { } at)
                    {
                        <div style="font-size:13px;color:var(--text-mid);margin-top:4px">at @at.ToString("h:mm tt")</div>
                    }
                    break;
                case CheckInResult.OutsideWindow:
                    var (opens, closes) = AttendanceService.CheckInWindow(_item);
                    <div style="font-size:36px;line-height:1">⏰</div>
                    <div style="font-family:'Fredoka One',cursive;font-size:18px;margin:6px 0">
                        @(CampTime.Now < opens ? $"Check-in opens at {opens:h:mm tt}" : $"Check-in closed at {closes:h:mm tt}")
                    </div>
                    @if (CampTime.Now < opens && DateOnly.FromDateTime(opens) != CampTime.Today)
                    {
                        <div style="font-size:13px;color:var(--text-mid)">on @opens.ToString("dddd, MMM d")</div>
                    }
                    else if (CampTime.Now >= opens)
                    {
                        <div style="font-size:13px;color:var(--text-mid)">Missed it? A staff member can check you in.</div>
                    }
                    break;
                case CheckInResult.WrongEvent:
                    <div style="font-size:14px;margin-bottom:12px">This session is part of <strong>@_item.CampEvent.Name</strong>, but you joined a different event.</div>
                    <a class="ccn-btn" href="@JoinUrl" style="text-decoration:none">Join @_item.CampEvent.Name</a>
                    break;
                case CheckInResult.NotRegistered:
                    <div style="font-size:36px;line-height:1">🔀</div>
                    <div style="font-family:'Fredoka One',cursive;font-size:18px;margin:6px 0">You're not signed up for this session</div>
                    <div style="font-size:13px;color:var(--text-mid)">Check your schedule for the session you picked, or ask an Admin to move you.</div>
                    break;
                case CheckInResult.NotAllowed:
                    <div style="font-size:14px;margin-bottom:12px">We need your name to check you in. Please join again with the event code.</div>
                    <a class="ccn-btn" href="@JoinUrl" style="text-decoration:none">Join</a>
                    break;
                default:
                    <div style="font-family:'Fredoka One',cursive;font-size:18px;margin:6px 0">Check-in isn't open for this item</div>
                    break;
            }
            <div style="margin-top:18px">
                <a href="/hub/schedule" style="font-size:13px;font-weight:700;color:var(--black)">Go to the schedule →</a>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Code { get; set; } = "";

    private bool _loading = true;
    private bool _signedIn;
    private ScheduleItem? _item;
    private CheckInResult _result;
    private DateTime? _checkedInAt;

    private string ReturnPath => $"/checkin/{Uri.EscapeDataString(Code)}";
    private string JoinUrl  => $"/join?returnUrl={Uri.EscapeDataString(ReturnPath)}";
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(ReturnPath)}";

    protected override async Task OnInitializedAsync()
    {
        await ThemeSvc.LoadAsync();
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _signedIn = user.Identity?.IsAuthenticated == true;

        if (_signedIn)
        {
            var outcome = await AttendanceSvc.QrCheckInAsync(user, Code);
            _item        = outcome.Item;
            _result      = outcome.Result;
            _checkedInAt = outcome.CheckedInAt;
        }
        else
        {
            _item = await AttendanceSvc.GetByCheckInCodeAsync(Code);
        }
        _loading = false;
    }

    private static string TimeRange(ScheduleItem i) =>
        i.EndTime.HasValue ? $"{i.StartTime:h:mm tt} – {i.EndTime.Value:h:mm tt}" : i.StartTime.ToString("h:mm tt");
}

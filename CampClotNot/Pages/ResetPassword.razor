@page "/reset-password"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject PasswordResetService Resets

<PageTitle>Set Password — Camp Clot Not</PageTitle>

<div class="ccn-panel" style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(360px,calc(100vw - 32px));padding:20px">
    @if (_loading)
    {
        <div style="text-align:center;font-family:'Nunito',sans-serif;font-size:13px;color:var(--text-mid);margin-bottom:16px">Checking your link…</div>
    }
    else if (_firstName is null)
    {
        <div style="font-family:'Fredoka One',cursive;font-size:20px;color:var(--black);text-align:center;margin-bottom:4px">Link Expired</div>
        <div style="text-align:center;font-family:'Nunito',sans-serif;font-size:13px;color:var(--text-mid);margin-bottom:16px">This link has expired or was already used. Reset links work once and expire after a while.</div>
        <a href="/forgot-password" class="ccn-btn" style="width:100%;padding:11px;background:var(--color-primary);font-size:16px;border:3px solid var(--black);box-shadow:4px 4px 0 var(--black);display:block;text-align:center;text-decoration:none;box-sizing:border-box">Send a New Link</a>
        <div style="margin-top:14px;text-align:center">
            <a href="/login" style="font-family:'Nunito',sans-serif;font-size:12px;color:var(--text-light)">← Back to sign in</a>
        </div>
    }
    else
    {
        <div style="font-family:'Fredoka One',cursive;font-size:20px;color:var(--black);text-align:center;margin-bottom:4px">Choose a Password</div>
        <div style="text-align:center;font-family:'Nunito',sans-serif;font-size:13px;color:var(--text-mid);margin-bottom:16px">Hi @_firstName! Set a new password to sign in.</div>

        @if (Error == "mismatch")
        {
            <div style="background:#FEE2E2;border:2px solid #E83030;border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:13px;font-weight:700;color:#C0392B">⚠️ Passwords don't match — please try again.</div>
        }
        else if (Error == "tooshort")
        {
            <div style="background:#FEE2E2;border:2px solid #E83030;border-radius:8px;padding:8px 12px;margin-bottom:12px;font-size:13px;font-weight:700;color:#C0392B">⚠️ Password must be at least @PasswordResetService.MinPasswordLength characters.</div>
        }

        <form method="post" action="/account/reset-password" style="display:flex;flex-direction:column;gap:12px">
            <input type="hidden" name="token" value="@Token" />
            <div>
                <label style="font-family:'Fredoka One',cursive;font-size:12px;color:var(--text-mid);display:block;margin-bottom:4px">New Password</label>
                <input type="password" name="newPassword" placeholder="••••••••"
                       required autocomplete="new-password" minlength="@PasswordResetService.MinPasswordLength"
                       style="width:100%;padding:10px 12px;border:3px solid var(--black);border-radius:8px;font-size:14px;font-family:'Nunito',sans-serif;box-sizing:border-box;background:var(--bg-base);color:var(--black);outline:none;box-shadow:2px 2px 0 var(--black)" />
            </div>
            <div>
                <label style="font-family:'Fredoka One',cursive;font-size:12px;color:var(--text-mid);display:block;margin-bottom:4px">Confirm Password</label>
                <input type="password" name="confirmPassword" placeholder="••••••••"
                       required autocomplete="new-password"
                       style="width:100%;padding:10px 12px;border:3px solid var(--black);border-radius:8px;font-size:14px;font-family:'Nunito',sans-serif;box-sizing:border-box;background:var(--bg-base);color:var(--black);outline:none;box-shadow:2px 2px 0 var(--black)" />
            </div>
            <button type="submit" class="ccn-btn" style="width:100%;padding:11px;background:var(--color-primary);font-size:16px;border:3px solid var(--black);box-shadow:4px 4px 0 var(--black)">Set Password &amp; Sign In</button>
        </form>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool _loading = true;
    private string? _firstName;

    protected override async Task OnParametersSetAsync()
    {
        var user = await Resets.ValidateTokenAsync(Token);
        _firstName = user is null ? null : (string.IsNullOrWhiteSpace(user.FirstName) ? "there" : user.FirstName);
        _loading = false;
    }
}

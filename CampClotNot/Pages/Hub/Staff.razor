@page "/hub/staff"
@attribute [Authorize(Policy = "HubGuestAccess")]
@inject StaffDirectoryService StaffSvc
@inject ActiveEventService ActiveEventSvc
@inject GuestAccessService GuestSvc
@inject AuthenticationStateProvider Auth

<PageTitle>Staff — Camp Clot Not</PageTitle>

@if (!_isGuest)
{
    <HubSubNav />
}

<div style="padding: 0 16px 100px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0"><img src="/img/icons/people.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Staff Directory</h2>
        @if (_isAdmin)
        {
            @* The directory is the event's team members marked "Show in Hub directory". *@
            <a class="ccn-btn" href="/admin/team" style="font-size:13px;text-decoration:none">✏️ Edit on Team</a>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!_cards.Any())
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No staff listed yet.</p>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
            @foreach (var m in _cards)
            {
                <div style="border:var(--panel-border);border-radius:10px;padding:16px;box-shadow:3px 3px 0 var(--border-color);background:var(--panel-bg);text-align:center;display:flex;flex-direction:column">
                    @if (m.HasPhoto)
                    {
                        <img src="/staff-photo/@m.UserId"
                             style="width:100%;aspect-ratio:1/1;object-fit:cover;object-position:@(m.PhotoObjectPosition ?? "50% 50%");border-radius:8px;border:2px solid var(--border-color);margin-bottom:8px;display:block"
                             alt="@m.Name" />
                    }
                    else
                    {
                        <div style="width:100%;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;font-size:48px;border-radius:8px;border:2px solid var(--border-color);margin-bottom:8px;background:#F5F0E4">@m.AvatarEmoji</div>
                    }
                    <div style="font-family:var(--font-display);font-weight:700;font-size:15px">@m.Name</div>
                    <div style="font-size:12px;color:var(--text-light);margin-bottom:8px">@m.Title</div>
                    @if (!string.IsNullOrEmpty(m.Phone))
                    {
                        <a href="@TelHref(m.Phone)" style="display:block;font-size:13px;color:#1a5fa8;text-decoration:none;margin-bottom:4px">@m.Phone</a>
                    }
                    @if (!string.IsNullOrEmpty(m.Email))
                    {
                        <a href="mailto:@m.Email" style="display:block;font-size:13px;color:#1a5fa8;text-decoration:none;overflow-wrap:break-word;word-break:break-all">@m.Email</a>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _isAdmin;
    private bool _isGuest;
    private List<DirectoryCard> _cards = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Admin");
        var guestEventId = GuestSvc.GetGuestEventId(authState.User);
        _isGuest = guestEventId.HasValue;
        var eventId = guestEventId ?? await ActiveEventSvc.GetActiveEventIdAsync();
        _cards = await StaffSvc.GetVisibleAsync(eventId);
        _loading = false;
    }

    private static string TelHref(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "tel:";
        var digits = System.Text.RegularExpressions.Regex.Replace(phone, @"[^\d]", "");
        // 11 digits starting with 1 means the country code is already included
        return digits.Length == 11 && digits[0] == '1'
            ? $"tel:+{digits}"
            : $"tel:+1{digits}";
    }
}

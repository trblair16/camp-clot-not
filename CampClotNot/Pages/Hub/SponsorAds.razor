@page "/hub/spotlight"
@page "/hub/sponsor-ads"
@attribute [Authorize(Policy = "HubGuestAccess")]
@inject SponsorAdService AdSvc
@inject ActiveEventService ActiveEventSvc
@inject GuestAccessService GuestSvc
@inject AuthenticationStateProvider Auth

<PageTitle>Sponsor Ads — Camp Clot Not</PageTitle>

@if (!_isGuest)
{
    <HubSubNav HideFabOnMobile="true" />
}

<div style="padding: 0 16px 100px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:0 0 20px">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0"><img src="/img/icons/trophy.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Sponsor Ads</h2>
        <a href="/hub/sponsors" class="ccn-btn" style="text-decoration:none;font-size:13px">🏆 Our Sponsors</a>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!_ads.Any())
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No sponsor ads yet.</p>
    }
    else
    {
        @* Sponsor ads (#350): full width at their own proportions, never cropped. A tap is counted
           for this event by /go/{event}/{ad}, which then opens the ad's link. Nothing here
           is named "ad" or "sponsor-ad": ad blockers hide or block anything that is. *@
        <div class="spot-list">
            @foreach (var ad in _ads)
            {
                @if (ad.Target is not null)
                {
                    <a href="/go/@_eventId/@ad.SponsorAdId" target="_blank" rel="noopener" class="spot-card" title="@ad.Title">
                        <img src="@ad.ImageSrc" alt="@ad.Title" />
                    </a>
                }
                else
                {
                    <div class="spot-card"><img src="@ad.ImageSrc" alt="@ad.Title" /></div>
                }
            }
        </div>
    }
</div>

<style>
    .spot-list { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .spot-card {
        display: block; width: 100%; max-width: 720px; overflow: hidden; line-height: 0;
        border: var(--panel-border); border-radius: 10px; box-shadow: var(--panel-shadow); background: var(--panel-bg);
    }
    .spot-card img { display: block; width: 100%; height: auto; }
    a.spot-card { transition: transform .12s ease; }
    a.spot-card:hover { transform: translateY(-2px); }
</style>

@code {
    private List<AdCard> _ads = [];
    private Guid _eventId;
    private bool _loading = true;
    private bool _isGuest;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var guestEventId = GuestSvc.GetGuestEventId(authState.User);
        _isGuest = guestEventId.HasValue;
        _eventId = guestEventId ?? await ActiveEventSvc.GetActiveEventIdAsync();
        _ads = await AdSvc.GetForEventAsync(_eventId);
        _loading = false;
    }
}

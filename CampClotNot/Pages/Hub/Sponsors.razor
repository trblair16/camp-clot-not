@page "/hub/sponsors"
@attribute [Authorize(Policy = "HubGuestAccess")]
@inject SponsorService SponsorSvc
@inject SponsorAdService AdSvc
@inject ActiveEventService ActiveEventSvc
@inject GuestAccessService GuestSvc
@inject AuthenticationStateProvider Auth

<PageTitle>Sponsors — Camp Clot Not</PageTitle>

@if (!_isGuest)
{
    <HubSubNav HideFabOnMobile="true" />
}

<div style="padding: 0 16px 100px">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0 0 20px"><img src="/img/icons/trophy.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Sponsors</h2>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!_sponsors.Any() && !_ads.Any())
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No sponsors yet.</p>
    }
    else
    {
        @* Sponsor ads (#350): full width at their own proportions, never cropped. A tap is counted
           for this event by /ads/{event}/{ad}, which then opens the ad's link. *@
        @if (_ads.Any())
        {
            <div class="sponsor-ads">
                @foreach (var ad in _ads)
                {
                    @if (ad.Target is not null)
                    {
                        <a href="/ads/@_eventId/@ad.SponsorAdId" target="_blank" rel="noopener" class="sponsor-ad" title="@ad.Title">
                            <img src="@ad.ImageSrc" alt="@ad.Title" loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <div class="sponsor-ad"><img src="@ad.ImageSrc" alt="@ad.Title" loading="lazy" /></div>
                    }
                }
            </div>
        }

        <div class="sponsors-grid">
            @foreach (var s in _sponsors)
            {
                <div class="sponsor-tile">
                    <div class="sponsor-logo-box">
                        @if (!string.IsNullOrWhiteSpace(s.Website))
                        {
                            <a href="@s.Website" target="_blank" rel="noopener noreferrer" class="sponsor-logo-link">
                                <img src="@LogoSrc(s)" alt="@s.Name" style="width:100%;height:80px;object-fit:contain" />
                            </a>
                        }
                        else
                        {
                            <img src="@LogoSrc(s)" alt="@s.Name" style="width:100%;height:80px;object-fit:contain" />
                        }
                    </div>
                    <div style="font-family:var(--font-display);font-weight:700;font-size:13px;color:var(--text-dark);margin-top:8px;text-align:center">@s.Name</div>
                    @if (!string.IsNullOrEmpty(s.ContactName))
                    {
                        <div style="font-size:.8rem;color:var(--text-light);text-align:center">@s.ContactName</div>
                    }
                    @if (!string.IsNullOrEmpty(s.Phone))
                    {
                        <a href="@TelHref(s.Phone)" style="font-size:.85rem;font-weight:700;color:var(--text-accent);text-decoration:none;text-align:center;display:block">@s.Phone</a>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .sponsor-ads { display: flex; flex-direction: column; align-items: center; gap: 16px; margin-bottom: 24px; }
    .sponsor-ad {
        display: block; width: 100%; max-width: 720px; overflow: hidden; line-height: 0;
        border: var(--panel-border); border-radius: 10px; box-shadow: var(--panel-shadow); background: var(--panel-bg);
    }
    .sponsor-ad img { display: block; width: 100%; height: auto; }
    a.sponsor-ad { transition: transform .12s ease; }
    a.sponsor-ad:hover { transform: translateY(-2px); }
    .sponsors-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }
    @@media (min-width: 480px) {
        .sponsors-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (min-width: 700px) {
        .sponsors-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    }
    .sponsor-tile {
        background: var(--panel-bg);
        border: var(--panel-border);
        border-radius: 10px;
        box-shadow: var(--panel-shadow);
        padding: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        --text-dark: var(--panel-text-dark); --text-mid: var(--panel-text-mid); --text-light: var(--panel-text-light); --text-accent: var(--panel-text-accent); --text-danger: var(--panel-text-danger); --text-success: var(--panel-text-success); --text-link: var(--panel-text-link); --text-warn: var(--panel-text-warn); color: var(--text-dark);
    }
    .sponsor-logo-box {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .sponsor-logo-link {
        display: block;
        text-decoration: none;
        width: 100%;
    }
    .sponsor-logo-link:hover img {
        opacity: .85;
    }
</style>

@code {
    private List<Sponsor> _sponsors = [];
    private List<AdCard> _ads = [];
    private Guid _eventId;
    private bool _loading = true;
    private bool _isGuest;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var guestEventId = GuestSvc.GetGuestEventId(authState.User);
        _isGuest = guestEventId.HasValue;
        var eventId = guestEventId ?? await ActiveEventSvc.GetActiveEventIdAsync();
        _eventId  = eventId;
        _sponsors = await SponsorSvc.GetAllForEventAsync(eventId);
        _ads      = await AdSvc.GetForEventAsync(eventId);
        _loading  = false;
    }

    private static string LogoSrc(Sponsor s) =>
        s.LogoContentType is not null ? $"/sponsors/logo/{s.SponsorId}" : (s.LogoUrl ?? "");

    private static string TelHref(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "tel:";
        var digits = System.Text.RegularExpressions.Regex.Replace(phone, @"[^\d]", "");
        return $"tel:+1{digits}";
    }
}

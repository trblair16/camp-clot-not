@page "/forgot-password"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Forgot Password — Camp Clot Not</PageTitle>

<div class="ccn-panel" style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(360px,calc(100vw - 32px));padding:20px">
    <div style="font-family:'Fredoka One',cursive;font-size:20px;color:var(--black);text-align:center;margin-bottom:4px">Forgot Password</div>

    @if (Sent)
    {
        <div style="text-align:center;font-family:'Nunito',sans-serif;font-size:13px;color:var(--text-mid);margin-bottom:16px">&nbsp;</div>
        <div style="background:#E3F4E1;border:2px solid #27AE60;border-radius:8px;padding:10px 12px;margin-bottom:12px;font-size:13px;font-weight:700;color:#1E6B3A">
            📧 If an account exists for that email, we've sent a link to reset your password. It expires in 1 hour.
        </div>
        <div style="font-family:'Nunito',sans-serif;font-size:12px;color:var(--text-mid);margin-bottom:12px">
            Nothing after a few minutes? Check your spam folder, or ask an event admin to send you a new link.
        </div>
    }
    else
    {
        <div style="text-align:center;font-family:'Nunito',sans-serif;font-size:13px;color:var(--text-mid);margin-bottom:16px">Enter your email and we'll send you a link to choose a new password.</div>
        <form method="post" action="/account/forgot-password" style="display:flex;flex-direction:column;gap:12px">
            <div>
                <label style="font-family:'Fredoka One',cursive;font-size:12px;color:var(--text-mid);display:block;margin-bottom:4px">Email</label>
                <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                       style="width:100%;padding:10px 12px;border:3px solid var(--black);border-radius:8px;font-size:14px;font-family:'Nunito',sans-serif;box-sizing:border-box;background:var(--bg-base);color:var(--black);outline:none;box-shadow:2px 2px 0 var(--black)" />
            </div>
            <button type="submit" class="ccn-btn" style="width:100%;padding:11px;background:var(--color-primary);font-size:16px;border:3px solid var(--black);box-shadow:4px 4px 0 var(--black)">Send Reset Link</button>
        </form>
    }

    <div style="margin-top:14px;text-align:center">
        <a href="/login" style="font-family:'Nunito',sans-serif;font-size:12px;color:var(--text-light)">← Back to sign in</a>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "sent")]
    public bool Sent { get; set; }
}

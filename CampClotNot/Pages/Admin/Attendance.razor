@page "/admin/attendance"
@attribute [Authorize(Roles = "Admin")]
@inject AttendanceService AttendanceSvc
@inject ActiveEventService ActiveEventSvc
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Attendance — Camp Clot Not</PageTitle>

<style>
    .att-day-tabs {
        display: flex;
        overflow-x: auto;
        scrollbar-width: none;
        border: var(--panel-border);
        border-radius: 10px;
        background: var(--panel-bg);
        box-shadow: 4px 4px 0 var(--border-color);
        margin-bottom: 16px;
    }
    .att-day-tabs::-webkit-scrollbar { display: none; }
    .att-day-tab {
        flex: 1 0 auto;
        min-width: 64px;
        padding: 10px 8px;
        border: none;
        border-bottom: 4px solid transparent;
        background: transparent;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        font-family: var(--font-display); font-weight: 700;
    }
    .att-day-tab:hover { background: rgba(26,26,26,.05); }
    .att-day-tab.active { border-bottom-color: var(--border-color); background: var(--bg-base); }
    .att-day-tab .tab-dow  { font-size: 11px; color: var(--text-light); letter-spacing: .5px; text-transform: uppercase; }
    .att-day-tab .tab-date { font-size: 18px; color: var(--text-dark); line-height: 1; }
    .att-day-tab .tab-count { font-size: 9px; color: var(--text-light); margin-top: 1px; }
    .att-item-row {
        display: flex; justify-content: space-between; align-items: center; gap: 10px;
        width: 100%; padding: 10px 14px; border: none; border-bottom: 2px solid #E8E0CC;
        background: transparent; cursor: pointer; text-align: left;
    }
    .att-item-row:last-child { border-bottom: none; }
    .att-item-row:hover { background: rgba(26,26,26,.04); }
    .att-item-row.selected { background: var(--bg-base); box-shadow: inset 4px 0 0 var(--border-color); }
    .att-pill {
        font-family: var(--font-display); font-weight: 700; font-size: 12px;
        padding: 2px 10px; border-radius: 50px; border: 2px solid var(--border-color);
        background: var(--panel-bg); white-space: nowrap;
    }
    .att-filter button {
        font-family: var(--font-display); font-weight: 700; font-size: 12px;
        padding: 6px 12px; border: none; background: transparent; cursor: pointer;
    }
    .att-filter button.active { background: var(--black); color: white; }
</style>

<div style="padding: 0 16px 100px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0"><img src="/img/icons/people.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Attendance</h2>
        @if (_event is not null && _trackedItems.Any())
        {
            <a class="ccn-btn" href="/admin/attendance/event/@_event.EventId/csv" download
               style="font-size:12px;padding:6px 14px;text-decoration:none;background:transparent">⬇ Download all (CSV)</a>
        }
    </div>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_event is null)
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No active event found.</p>
    }
    else
    {
        <div class="att-day-tabs">
            @foreach (var day in AllDays())
            {
                var count = _trackedItems.Count(i => i.CampDay == day);
                <button class="att-day-tab @(day == _selectedDay ? "active" : "")" @onclick="() => SelectDay(day)">
                    <span class="tab-dow">@day.ToString("ddd")</span>
                    <span class="tab-date">@day.Day</span>
                    <span class="tab-count">@(count == 0 ? "—" : $"{count} tracked")</span>
                </button>
            }
        </div>

        <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">

            @* ── Tracked items for the day ── *@
            <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);flex:0 0 320px;min-width:260px;overflow:hidden">
                <div style="padding:12px 14px;border-bottom:2px solid var(--border-color);font-family:var(--font-display);font-weight:700;font-size:14px">Tracked items</div>
                @{ var dayItems = _trackedItems.Where(i => i.CampDay == _selectedDay).ToList(); }
                @if (!dayItems.Any())
                {
                    <p style="font-size:13px;color:var(--text-mid);margin:0;padding:14px">
                        No items on this day are tracking attendance. Tick <strong>Track attendance</strong> on an item in
                        <a href="/admin/schedule">Schedule</a> to add it here.
                    </p>
                }
                else
                {
                    @foreach (var item in dayItems)
                    {
                        var it = item;
                        <button class="att-item-row @(it.ScheduleItemId == _selectedItemId ? "selected" : "")" @onclick="() => SelectItem(it.ScheduleItemId)">
                            <div style="min-width:0">
                                <div style="font-size:11px;color:var(--text-light);font-weight:700">@TimeRange(it)</div>
                                <div style="font-family:var(--font-display);font-weight:700;font-size:14px;color:var(--text-dark);overflow-wrap:break-word">@it.Title</div>
                            </div>
                            <span class="att-pill">@_counts.GetValueOrDefault(it.ScheduleItemId)</span>
                        </button>
                    }
                }
            </div>

            @* ── Roster ── *@
            <div style="flex:1;min-width:260px">
                @if (SelectedItem is { } sel)
                {
                    var checkedIn = _roster.Where(r => r.IsCheckedIn).ToList();
                    <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);padding:14px 16px;margin-bottom:14px">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap">
                            <div style="min-width:0">
                                <div style="font-family:var(--font-display);font-weight:700;font-size:18px;color:var(--text-dark)">@sel.Title</div>
                                <div style="font-size:12px;color:var(--text-light);font-weight:700">@sel.CampDay.ToString("dddd, MMM d") · @TimeRange(sel)</div>
                                <div style="font-size:13px;margin-top:6px;color:var(--text-mid)">
                                    <strong style="color:var(--text-dark)">@checkedIn.Count checked in</strong>
                                    · @checkedIn.Count(r => r.IsGuest) guests · @checkedIn.Count(r => !r.IsGuest) staff
                                </div>
                            </div>
                            <div style="display:flex;gap:6px;flex-wrap:wrap">
                                <button class="ccn-btn" style="font-size:12px;padding:6px 12px;background:transparent" @onclick="RefreshAsync">↻ Refresh</button>
                                <a class="ccn-btn" href="/admin/attendance/item/@sel.ScheduleItemId/csv" download
                                   style="font-size:12px;padding:6px 12px;text-decoration:none">⬇ CSV</a>
                            </div>
                        </div>
                    </div>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px">
                        <input type="search" placeholder="Search names…" @bind="_search" @bind:event="oninput"
                               style="flex:1;min-width:180px;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                        <div class="att-filter" style="display:flex;border:var(--panel-border);border-radius:7px;overflow:hidden;background:var(--panel-bg);box-shadow:2px 2px 0 var(--border-color)">
                            <button class="@(_filter == RosterFilter.All ? "active" : "")" @onclick="() => _filter = RosterFilter.All">All</button>
                            <button class="@(_filter == RosterFilter.In ? "active" : "")" @onclick="() => _filter = RosterFilter.In">Checked in</button>
                            <button class="@(_filter == RosterFilter.Out ? "active" : "")" @onclick="() => _filter = RosterFilter.Out">Not yet</button>
                        </div>
                    </div>

                    @if (!FilteredRoster.Any())
                    {
                        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No one matches.</p>
                    }
                    else
                    {
                        <div style="border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);overflow-x:auto;background:var(--panel-bg)">
                            <table style="width:100%;border-collapse:collapse;min-width:480px">
                                <thead>
                                    <tr style="background:var(--black)">
                                        <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Name</th>
                                        <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Type</th>
                                        <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in FilteredRoster)
                                    {
                                        var entry = r;
                                        <tr style="border-bottom:2px solid #E8E0CC">
                                            <td style="padding:10px 14px;font-size:13px;font-weight:700">@entry.LastName, @entry.FirstName</td>
                                            <td style="padding:10px 14px">
                                                <span style="font-size:11px;padding:2px 8px;border-radius:4px;background:@(entry.IsGuest ? "#16A085" : "#566573");color:white;font-family:var(--font-display);font-weight:700;white-space:nowrap">@entry.TypeLabel</span>
                                            </td>
                                            <td style="padding:8px 10px">
                                                @if (entry.IsCheckedIn)
                                                {
                                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                                                        <span style="font-size:12px;font-weight:700;color:#1E7F46">
                                                            ✓ @entry.CheckedInAt?.ToString("h:mm tt")
                                                            <span style="color:var(--text-light);font-weight:600">· @(entry.Method == AttendanceMethod.Self ? "Self" : $"by {entry.CheckedInByName ?? "Admin"}")</span>
                                                        </span>
                                                        <button class="ccn-btn" style="font-size:11px;padding:3px 10px;background:transparent;color:#D12B2B;border-color:#D12B2B"
                                                                disabled="@_busy" @onclick="() => UndoAsync(entry)">Undo</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button class="ccn-btn" style="font-size:11px;padding:4px 12px"
                                                            disabled="@_busy" @onclick="() => CheckInAsync(entry)">Check In</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (dayItems.Any())
                {
                    <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">Pick an item to see its roster.</p>
                }
            </div>
        </div>
    }
</div>

@if (SelectedItem is not null)
{
    <button class="ccn-btn ccn-fab-mobile" style="position:fixed;bottom:24px;right:24px;z-index:50;font-size:14px;padding:12px 20px;border-radius:50px;box-shadow:4px 4px 0 var(--border-color)"
            @onclick="OpenWalkIn">+ Walk-in</button>
}

@if (_walkInOpen)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.65);z-index:150;display:flex;align-items:center;justify-content:center;padding:20px;animation:fadeIn .2s ease"
         @onclick="CloseWalkIn">
        <div class="ccn-panel" style="padding:20px;width:100%;max-width:400px;box-shadow:8px 8px 0 var(--black);animation:popIn .25s ease" @onclick:stopPropagation>
            <div style="font-family:var(--font-display);font-weight:700;font-size:18px;margin-bottom:4px">Add a walk-in</div>
            <div style="font-size:12px;color:var(--text-light);margin-bottom:16px">Checks them in to <strong>@SelectedItem?.Title</strong>. If they've joined before under the same name, it uses their existing guest record.</div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">First Name</div>
                <input type="text" @bind="_wFirstName"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>
            <div style="margin-bottom:16px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Last Name</div>
                <input type="text" @bind="_wLastName"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            @if (!string.IsNullOrEmpty(_walkInError))
            {
                <div style="color:#D12B2B;font-size:12px;margin-bottom:10px">@_walkInError</div>
            }

            <div style="display:flex;gap:8px;justify-content:flex-end">
                <button class="ccn-btn" style="background:transparent" @onclick="CloseWalkIn">Cancel</button>
                <button class="ccn-btn" disabled="@_busy" @onclick="SaveWalkInAsync">Check In</button>
            </div>
        </div>
    </div>
}

@code {
    private enum RosterFilter { All, In, Out }

    private bool _loading = true;
    private bool _busy;
    private Event? _event;
    private Guid _adminUserId;
    private List<ScheduleItem> _trackedItems = [];
    private Dictionary<Guid, int> _counts = new();
    private DateOnly? _selectedDay;
    private Guid? _selectedItemId;
    private List<RosterEntry> _roster = [];
    private string _search = "";
    private RosterFilter _filter = RosterFilter.All;

    private bool _walkInOpen;
    private string _wFirstName = "";
    private string _wLastName = "";
    private string _walkInError = "";

    private ScheduleItem? SelectedItem =>
        _selectedItemId is { } id ? _trackedItems.FirstOrDefault(i => i.ScheduleItemId == id) : null;

    private IEnumerable<RosterEntry> FilteredRoster =>
        _roster.Where(r =>
            (_filter == RosterFilter.All || (_filter == RosterFilter.In) == r.IsCheckedIn) &&
            (string.IsNullOrWhiteSpace(_search) || r.FullName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _adminUserId);

        _event = await ActiveEventSvc.GetActiveEventAsync();
        if (_event is not null)
        {
            _trackedItems = await AttendanceSvc.GetTrackedItemsAsync(_event.EventId);
            _counts       = await AttendanceSvc.GetCountsAsync(_event.EventId);

            // Same default-day rule as /hub/schedule: before → first day, during → today, after → last day.
            var today = CampTime.Today;
            var day = today < _event.EffDate ? _event.EffDate
                    : today > _event.ExpDate ? _event.ExpDate
                    : today;
            await SelectDay(day);
        }
        _loading = false;
    }

    private IEnumerable<DateOnly> AllDays()
    {
        if (_event is null) yield break;
        for (var d = _event.EffDate; d <= _event.ExpDate; d = d.AddDays(1))
            yield return d;
    }

    private async Task SelectDay(DateOnly day)
    {
        _selectedDay = day;
        var dayItems = _trackedItems.Where(i => i.CampDay == day).ToList();
        // Prefer the item whose check-in window is open right now, otherwise the day's first item.
        var pick = dayItems.FirstOrDefault(i => AttendanceService.IsSelfCheckInOpen(i, CampTime.Now)) ?? dayItems.FirstOrDefault();
        if (pick is null)
        {
            _selectedItemId = null;
            _roster = [];
            return;
        }
        await SelectItem(pick.ScheduleItemId);
    }

    private async Task SelectItem(Guid scheduleItemId)
    {
        _selectedItemId = scheduleItemId;
        _search = "";
        _filter = RosterFilter.All;
        _roster = await AttendanceSvc.GetRosterAsync(scheduleItemId);
    }

    private async Task RefreshAsync()
    {
        if (_event is null) return;
        _counts = await AttendanceSvc.GetCountsAsync(_event.EventId);
        if (_selectedItemId is { } id)
            _roster = await AttendanceSvc.GetRosterAsync(id);
    }

    private async Task CheckInAsync(RosterEntry entry)
    {
        if (_selectedItemId is not { } itemId || _busy) return;
        _busy = true;
        try
        {
            var result = await AttendanceSvc.AdminCheckInAsync(itemId, entry.GuestAttendeeId, entry.UserId, _adminUserId);
            if (result == CheckInResult.NotTracked)
                Snackbar.Add("This item is no longer tracking attendance.", Severity.Warning);
            await RefreshAsync();
        }
        finally { _busy = false; }
    }

    private async Task UndoAsync(RosterEntry entry)
    {
        if (entry.AttendanceId is not { } attendanceId || _busy) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Undo check-in for {entry.FullName}?")) return;
        _busy = true;
        try
        {
            await AttendanceSvc.UndoCheckInAsync(attendanceId);
            await RefreshAsync();
        }
        finally { _busy = false; }
    }

    private void OpenWalkIn()
    {
        _wFirstName = "";
        _wLastName = "";
        _walkInError = "";
        _walkInOpen = true;
    }

    private void CloseWalkIn() => _walkInOpen = false;

    private async Task SaveWalkInAsync()
    {
        _walkInError = "";
        if (string.IsNullOrWhiteSpace(_wFirstName) || string.IsNullOrWhiteSpace(_wLastName))
        {
            _walkInError = "First and last name are both required.";
            return;
        }
        if (_selectedItemId is not { } itemId || _busy) return;

        _busy = true;
        try
        {
            var result = await AttendanceSvc.CheckInWalkInAsync(itemId, _wFirstName, _wLastName, _adminUserId);
            var name = $"{_wFirstName.Trim()} {_wLastName.Trim()}";
            switch (result)
            {
                case CheckInResult.CheckedIn:
                    Snackbar.Add($"{name} checked in.", Severity.Success);
                    break;
                case CheckInResult.AlreadyCheckedIn:
                    Snackbar.Add($"{name} was already checked in.", Severity.Info);
                    break;
                default:
                    Snackbar.Add("This item is no longer tracking attendance.", Severity.Warning);
                    break;
            }
            _walkInOpen = false;
            await RefreshAsync();
        }
        finally { _busy = false; }
    }

    private static string TimeRange(ScheduleItem i) =>
        i.EndTime.HasValue ? $"{i.StartTime:h:mm tt} – {i.EndTime.Value:h:mm tt}" : i.StartTime.ToString("h:mm tt");
}

@page "/admin/schedule"
@attribute [Authorize(Roles = "Admin")]
@inject ScheduleService ScheduleSvc
@inject ScheduleItemTypeService ScheduleItemTypeSvc
@inject LocationService LocationSvc
@inject MiniGameService MiniGameSvc
@inject ActiveEventService ActiveEventSvc
@inject RegistrationService RegistrationSvc
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using CampClotNot.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>Schedule Admin — Camp Clot Not</PageTitle>

<style>
    @@media (max-width: 699px) {
        .admin-sched-desc        { display: none; }
        .admin-sched-loc-img     { display: none; }
        .admin-sched-table       { display: none; }
        .admin-sched-cards       { display: flex; flex-direction: column; gap: 10px; }
        .admin-sched-form        { display: none; }
        .admin-sched-add-mobile  { display: block; margin-bottom: 12px; }
    }
    @@media (min-width: 700px) {
        .admin-sched-cards      { display: none; }
        .admin-sched-add-mobile { display: none; }
    }
</style>

<div style="padding: 0 16px 100px">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0 0 20px"><img src="/img/icons/schedule.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Schedule Events</h2>

    <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">

        @* ── Form panel (desktop) / mobile overlay ── *@
        <div style="@(_mobileFormOpen ? "position:fixed;inset:0;background:rgba(26,26,26,.65);z-index:100;overflow-y:auto;display:flex;align-items:flex-start;justify-content:center;padding:16px;animation:fadeIn .15s ease" : "display:contents")"
             @onclick="CloseFormOverlay">
        <div class="admin-sched-form" style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:@(_mobileFormOpen ? "8px 8px 0 var(--border-color)" : "4px 4px 0 var(--border-color)");padding:20px;flex:0 0 340px;min-width:280px;@(_mobileFormOpen ? "display:block !important;max-width:480px;width:100%;margin:auto;animation:popIn .2s ease" : "")"
             @onclick:stopPropagation>
            @if (!string.IsNullOrEmpty(_copyingFromTitle))
            {
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:4px;font-family:'Nunito',sans-serif">Copying: @_copyingFromTitle</div>
            }
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
                <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0">
                    @(!string.IsNullOrEmpty(_copyingFromTitle) ? "Copy to New Day" : _editingId == Guid.Empty ? "Add Event" : "Edit Event")
                </h3>
                @if (_mobileFormOpen)
                {
                    <button @onclick="CloseFormOverlay" style="background:none;border:none;font-size:22px;cursor:pointer;line-height:1;color:var(--text-light);padding:0">✕</button>
                }
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Title</div>
                <input type="text" @bind="_fTitle" placeholder="e.g. Morning Swim"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Day</div>
                <input type="date" value="@_fDateStr" min="@_minDate" max="@_maxDate" disabled="@(_fParentId is not null)"
                       title="@(_fParentId is not null ? "Options are on their slot's day" : null)"
                       @onchange="e => _fDateStr = e.Value?.ToString() ?? string.Empty"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="display:flex;gap:10px;margin-bottom:14px">
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Start</div>
                    <input type="text" @bind="_fStartStr" placeholder="9:30 AM"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">End (optional)</div>
                    <input type="text" @bind="_fEndStr" placeholder="10:30 AM"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Type</div>
                <select value="@_fTypeId.ToString()"
                        @onchange="e => _fTypeId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : _fTypeId"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box">
                    @foreach (var t in _scheduleItemTypes)
                    {
                        <option value="@t.ScheduleItemTypeId">@DisplayItemType(t)</option>
                    }
                </select>
            </div>

            @if (SelectedTypeSystemName == "Presentation")
            {
                <div style="margin-bottom:14px">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Presenter Name</div>
                    <input type="text" @bind="_fPresenterName" placeholder="e.g. Dr. Jane Smith"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
                <div style="margin-bottom:14px">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Presenter Bio (optional)</div>
                    <textarea @bind="_fPresenterBio" rows="3" placeholder="Short bio shown to attendees"
                              style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;resize:vertical"></textarea>
                </div>
            }

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Location (optional)</div>
                <select value="@(_fLocationId?.ToString() ?? "")"
                        @onchange="e => _fLocationId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box">
                    <option value="">— None —</option>
                    @foreach (var loc in _locations)
                    {
                        <option value="@loc.LocationId">@loc.Name</option>
                    }
                </select>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Additional Information (optional)</div>
                <input type="text" @bind="_fLocationOther" placeholder="e.g. Gym + Pool deck"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Activity (optional)</div>
                <select value="@(_fActivityId?.ToString() ?? "")"
                        @onchange="e => _fActivityId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box">
                    <option value="">— N/A —</option>
                    @foreach (var act in _activities)
                    {
                        <option value="@act.ActivityId">@act.Name</option>
                    }
                </select>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Breakout</div>
                <select value="@BreakoutValue" @onchange="e => OnBreakoutChanged(e.Value?.ToString())"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box">
                    <option value="">None — a regular item</option>
                    <option value="slot">This is a breakout slot (people pick one option)</option>
                    @foreach (var slot in _events.Where(x => x.IsBreakoutSlot && x.ScheduleItemId != _editingId))
                    {
                        <option value="@slot.ScheduleItemId">Option in: @slot.Title (@slot.CampDay.ToString("ddd M/d") @slot.StartTime.ToString("h:mm tt"))</option>
                    }
                </select>
            </div>

            @if (_fIsSlot)
            {
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;cursor:pointer;font-size:13px;font-weight:700;color:var(--text-dark)">
                    <input type="checkbox" checked="@_fAllowSelfSignup" @onchange="() => _fAllowSelfSignup = !_fAllowSelfSignup" />
                    Allow self sign-up
                </label>
                <div style="font-size:11px;color:var(--text-light);margin-bottom:14px">
                    @if (_fAllowSelfSignup) { <span>Guests and staff pick an option from the schedule.</span> }
                    else { <span>People see "Your session will be assigned" — assign them on Breakouts.</span> }
                    Add options by creating items with "Option in: this slot". Attendance is tracked per option.
                </div>
            }
            else
            {
                @if (_fParentId is not null)
                {
                    <div style="margin-bottom:14px">
                        <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Capacity (optional)</div>
                        <input type="number" min="1" value="@_fCapacity"
                               @onchange="e => _fCapacity = int.TryParse(e.Value?.ToString(), out var c) && c > 0 ? c : null"
                               placeholder="Unlimited"
                               style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                    </div>
                }

                <label style="display:flex;align-items:center;gap:8px;margin-bottom:@(_fTrackAttendance ? "8px" : "14px");cursor:pointer;font-size:13px;font-weight:700;color:var(--text-dark)">
                    <input type="checkbox" checked="@_fTrackAttendance" @onchange="() => _fTrackAttendance = !_fTrackAttendance" />
                    Track attendance
                    <span style="font-weight:600;font-size:12px;color:var(--text-light)">— check-in by button or QR code</span>
                </label>
                @if (_fTrackAttendance)
                {
                    <div style="margin:0 0 14px 24px">
                        <select value="@_fCheckInMode.ToString()"
                                @onchange="e => _fCheckInMode = Enum.TryParse<SelfCheckInMode>(e.Value?.ToString(), out var m) ? m : SelfCheckInMode.ButtonAndQr"
                                style="width:100%;padding:7px 10px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box">
                            <option value="@SelfCheckInMode.ButtonAndQr">"I'm here" button + QR code</option>
                            <option value="@SelfCheckInMode.QrOnly">QR code only (must be in the room)</option>
                        </select>
                        <div style="font-size:11px;color:var(--text-light);margin-top:4px">Show or print the QR from Attendance.</div>
                    </div>
                }
            }

            @* ── Group Assignments ── *@
            <div style="border:2px solid #E8E0CC;border-radius:8px;margin-bottom:16px;overflow:hidden">
                <button type="button"
                        style="width:100%;padding:10px 12px;background:#F8F4EC;border:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:8px"
                        @onclick="() => _assignmentsExpanded = !_assignmentsExpanded">
                    <div style="display:flex;align-items:center;gap:8px">
                        <span style="font-family:var(--font-display);font-weight:700;font-size:13px">Group Assignments</span>
                        <span style="font-size:11px;padding:2px 8px;border-radius:4px;background:#E8E0CC;color:var(--text-light);font-family:var(--font-display);font-weight:700">
                            @(_assignedCount > 0 ? $"{_assignedCount} set" : "Optional")
                        </span>
                    </div>
                    <span style="font-size:11px;color:var(--text-light)">@(_assignmentsExpanded ? "▲" : "▼")</span>
                </button>
                @if (!_assignmentsExpanded)
                {
                    <div style="padding:6px 12px 8px;font-size:11px;color:var(--text-light);border-top:1px solid #E8E0CC">
                        Use for rotation slots where each group does a different activity.
                    </div>
                }
                else
                {
                    <div style="padding:12px">
                        @foreach (var row in _fAssignments)
                        {
                            var group = _groups.FirstOrDefault(g => g.GroupId == row.GroupId);
                            <div style="margin-bottom:10px;padding:8px;background:#F8F4EC;border-radius:6px">
                                <div style="font-family:var(--font-display);font-weight:700;font-size:12px;color:@(group?.Color ?? "#555");margin-bottom:6px">
                                    @(group?.Name ?? "—")
                                </div>
                                <div style="margin-bottom:6px">
                                    <div style="font-size:10px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--text-light);margin-bottom:3px">Activity</div>
                                    <select value="@(row.ActivityId?.ToString() ?? "")"
                                            @onchange="e => row.ActivityId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                            style="width:100%;padding:6px 8px;background:var(--bg-base);border:2px solid var(--border-color);border-radius:5px;font-size:12px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark)">
                                        <option value="">— None —</option>
                                        @foreach (var act in _activities)
                                        {
                                            <option value="@act.ActivityId">@act.Name</option>
                                        }
                                    </select>
                                </div>
                                <div style="margin-bottom:6px">
                                    <div style="font-size:10px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--text-light);margin-bottom:3px">Location override</div>
                                    <select value="@(row.LocationId?.ToString() ?? "")"
                                            @onchange="e => row.LocationId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : null"
                                            style="width:100%;padding:6px 8px;background:var(--bg-base);border:2px solid var(--border-color);border-radius:5px;font-size:12px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark)">
                                        <option value="">— None —</option>
                                        @foreach (var loc in _locations)
                                        {
                                            <option value="@loc.LocationId">@loc.Name</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <div style="font-size:10px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--text-light);margin-bottom:3px">Note</div>
                                    <input type="text" value="@(row.Note ?? "")"
                                           @onchange="e => row.Note = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()"
                                           style="width:100%;padding:6px 8px;background:var(--bg-base);border:2px solid var(--border-color);border-radius:5px;font-size:12px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-sizing:border-box" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div style="color:#D12B2B;font-size:12px;margin-bottom:10px">@_error</div>
            }

            <div style="display:flex;gap:8px">
                <button class="ccn-btn" @onclick="SaveAsync">@(_editingId == Guid.Empty ? "Add Event" : "Save Changes")</button>
                @if (_editingId != Guid.Empty)
                {
                    <button class="ccn-btn" style="background:transparent" @onclick="CancelEdit">Cancel</button>
                }
            </div>
        </div>
        </div>

        @* ── Table ── *@
        <div style="flex:1;min-width:300px">
            <button class="ccn-btn admin-sched-add-mobile" @onclick="() => _mobileFormOpen = true">+ Add Event</button>

            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (!_events.Any())
            {
                <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No events yet. Add the first one →</p>
            }
            else
            {
                @* ── Mobile card list ── *@
                <div class="admin-sched-cards">
                    @foreach (var ev in OrderedEvents)
                    {
                        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:3px 3px 0 var(--border-color);padding:12px 14px;@(ev.ParentScheduleItemId is not null ? "margin-left:22px;border-left-width:6px" : "")">
                            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                                <div style="flex:1;min-width:0">
                                    <div style="font-size:11px;color:var(--text-light);font-weight:700;margin-bottom:3px">
                                        @ev.CampDay.ToString("ddd M/d") &nbsp;·&nbsp; @ev.StartTime.ToString("h:mm tt")@(ev.EndTime.HasValue ? $" – {ev.EndTime.Value.ToString("h:mm tt")}" : "")
                                    </div>
                                    <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--text-dark);line-height:1.2;margin-bottom:6px">
                                        @ev.Title
                                        @BreakoutChips(ev)
                                        @if (ev.TrackAttendance)
                                        {
                                            <span style="font-size:10px;padding:1px 6px;border-radius:4px;background:#E8E0CC;border:1px solid #9E8C70;color:var(--text-dark);font-family:var(--font-display);font-weight:700;white-space:nowrap">📋 Attendance</span>
                                        }
                                    </div>
                                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                                        <span style="font-size:11px;padding:2px 8px;border-radius:4px;background:@ItemTypeBadgeColor(ev.ScheduleItemType?.BadgeColor, ev.ScheduleItemType?.SystemName);color:white;font-family:var(--font-display);font-weight:700">
                                            @DisplayItemType(ev.ScheduleItemType)
                                        </span>
                                        @if (ev.Location is not null)
                                        {
                                            <span style="font-size:11px;color:var(--text-mid)">@ev.Location.Name@(!string.IsNullOrEmpty(ev.LocationOther) ? $" + {ev.LocationOther}" : "")</span>
                                        }
                                        else if (!string.IsNullOrEmpty(ev.LocationOther))
                                        {
                                            <span style="font-size:11px;color:var(--text-mid)">@ev.LocationOther</span>
                                        }
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;gap:4px;flex-shrink:0">
                                    <button class="ccn-btn" style="font-size:11px;padding:4px 12px" @onclick="() => { StartEdit(ev); _mobileFormOpen = true; }">Edit</button>
                                    <button class="ccn-btn" style="font-size:11px;padding:4px 12px;background:#117A65;color:white" @onclick="() => { StartCopy(ev); _mobileFormOpen = true; }">Copy</button>
                                    <button class="ccn-btn" style="font-size:11px;padding:4px 12px;background:#D12B2B;color:white" @onclick="() => DeleteAsync(ev)">Del</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* ── Desktop table ── *@
                <div class="admin-sched-table" style="border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);overflow:hidden">
                    <div style="overflow-x:auto">
                    <table style="width:100%;border-collapse:collapse;min-width:520px">
                        <colgroup>
                            <col style="width:9%" />
                            <col style="width:13%" />
                            <col />
                            <col style="width:11%" />
                            <col style="width:16%" />
                            <col style="width:1%" />
                        </colgroup>
                        <thead>
                            <tr style="background:var(--black)">
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Day</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Time</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Title</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Type</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Location</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in OrderedEvents)
                            {
                                <tr style="border-bottom:2px solid #E8E0CC;@(ev.ParentScheduleItemId is not null ? "background:#FBF8F1" : "")">
                                    <td style="padding:8px 14px;font-size:13px;font-weight:700;white-space:nowrap">@ev.CampDay.ToString("ddd M/d")</td>
                                    <td style="padding:8px 14px;font-size:12px;color:var(--text-mid);white-space:nowrap">
                                        @ev.StartTime.ToString("h:mm tt")
                                        @if (ev.EndTime.HasValue)
                                        {
                                            <span>–@ev.EndTime.Value.ToString("h:mm tt")</span>
                                        }
                                    </td>
                                    <td style="padding:8px 14px;font-size:13px;@(ev.ParentScheduleItemId is not null ? "padding-left:30px" : "")">
                                        @if (ev.ParentScheduleItemId is not null) { <span style="color:var(--text-light)">↳ </span> }
                                        @ev.Title
                                        @BreakoutChips(ev)
                                        @if (ev.TrackAttendance)
                                        {
                                            <span style="font-size:10px;padding:1px 6px;border-radius:4px;background:#E8E0CC;border:1px solid #9E8C70;color:var(--text-dark);font-family:var(--font-display);font-weight:700;white-space:nowrap">📋 Attendance</span>
                                        }
                                        @if (!string.IsNullOrEmpty(ev.Description))
                                        {
                                            <div class="admin-sched-desc" style="font-size:11px;color:var(--text-light)">@ev.Description</div>
                                        }
                                        @if (ev.ItemGroups.Any())
                                        {
                                            <div class="admin-sched-desc" style="font-size:11px;color:var(--text-light)">@ev.ItemGroups.Count group assign.</div>
                                        }
                                    </td>
                                    <td style="padding:8px 14px">
                                        <span style="font-size:11px;padding:2px 8px;border-radius:4px;background:@ItemTypeBadgeColor(ev.ScheduleItemType?.BadgeColor, ev.ScheduleItemType?.SystemName);color:white;font-family:var(--font-display);font-weight:700">
                                            @DisplayItemType(ev.ScheduleItemType)
                                        </span>
                                    </td>
                                    <td style="padding:6px 14px;font-size:12px;color:var(--text-mid)">
                                        @if (ev.Location is not null)
                                        {
                                            <div style="display:flex;align-items:center;gap:6px">
                                                @if (ev.Location.ImageContentType is not null)
                                                {
                                                    <img src="/location-image/@ev.Location.LocationId"
                                                         class="admin-sched-loc-img"
                                                         style="width:42px;height:30px;object-fit:cover;border-radius:3px;border:2px solid var(--border-color);cursor:zoom-in;flex-shrink:0"
                                                         alt="@ev.Location.Name"
                                                         @onclick='() => _lightboxSrc = $"/location-image/{ev.Location.LocationId}"' />
                                                }
                                                <span>@ev.Location.Name@(!string.IsNullOrEmpty(ev.LocationOther) ? $" + {ev.LocationOther}" : "")</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(ev.LocationOther))
                                        {
                                            @ev.LocationOther
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td style="padding:8px 10px">
                                        <div style="display:flex;gap:4px">
                                            <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => StartEdit(ev)">Edit</button>
                                            <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:#117A65;color:white" @onclick="() => StartCopy(ev)">Copy</button>
                                            <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:#D12B2B;color:white" @onclick="() => DeleteAsync(ev)">Del</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@if (_lightboxSrc is not null)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.85);z-index:200;display:flex;align-items:center;justify-content:center;animation:fadeIn .15s ease;cursor:zoom-out"
         @onclick="() => _lightboxSrc = null">
        <img src="@_lightboxSrc"
             style="max-width:92vw;max-height:88vh;object-fit:contain;border:var(--panel-border);border-radius:10px;box-shadow:6px 6px 0 var(--border-color);animation:popIn .2s ease"
             alt="Location image" @onclick:stopPropagation />
        <button style="position:fixed;top:16px;right:20px;background:none;border:none;color:white;font-size:28px;cursor:pointer;line-height:1"
                @onclick="() => _lightboxSrc = null">✕</button>
    </div>
}

@code {
    private List<ScheduleItem> _events = new();
    private List<ScheduleItemType> _scheduleItemTypes = new();
    private List<Location> _locations = new();
    private List<Activity> _activities = new();
    private List<Group> _groups = new();
    private bool _loading = true;
    private Guid _userId;
    private Guid _editingId;
    private Guid _eventId;

    private string _fTitle = "";
    private string _fDateStr = "";
    private string _fStartStr = "";
    private string _fEndStr = "";
    private Guid _fTypeId;
    private Guid? _fLocationId;
    private string? _fLocationOther;
    private Guid? _fActivityId;
    private string? _fDesc;
    private string? _fPresenterName;
    private string? _fPresenterBio;
    private bool _fTrackAttendance;
    private SelfCheckInMode _fCheckInMode;
    private bool _fIsSlot;
    private bool _fAllowSelfSignup = true;
    private Guid? _fParentId;
    private int? _fCapacity;
    private Dictionary<Guid, int> _optionCounts = new();

    private string BreakoutValue => _fIsSlot ? "slot" : _fParentId?.ToString() ?? "";

    // Slots are followed by their options; everything else stays in day/time order.
    private IEnumerable<ScheduleItem> OrderedEvents => ScheduleVisibility.OrderWithOptionsUnderSlots(_events);

    private RenderFragment BreakoutChips(ScheduleItem ev) => __builder =>
    {
        if (ev.IsBreakoutSlot)
        {
            <span style="font-size:10px;padding:1px 6px;border-radius:4px;background:#FFF3C4;border:1px solid #C9A227;color:var(--text-dark);font-family:var(--font-display);font-weight:700;white-space:nowrap">🔀 Breakout@(ev.AllowSelfSignup ? "" : " · assigned")</span>
        }
        else if (ev.ParentScheduleItemId is not null)
        {
            var n = _optionCounts.GetValueOrDefault(ev.ScheduleItemId);
            var over = ev.MaxCapacity is { } c && n > c;
            <span style="font-size:10px;padding:1px 6px;border-radius:4px;background:@(over ? "#FEE2E2" : "#E8F4EA");border:1px solid @(over ? "#D12B2B" : "#27AE60");color:var(--text-dark);font-family:var(--font-display);font-weight:700;white-space:nowrap">👥 @n@(ev.MaxCapacity is { } cap ? $" / {cap}" : "")</span>
        }
    };

    private void OnBreakoutChanged(string? value)
    {
        _fIsSlot = value == "slot";
        _fParentId = Guid.TryParse(value, out var id) ? id : null;
        if (_fParentId is { } pid && _events.FirstOrDefault(e => e.ScheduleItemId == pid) is { } slot)
        {
            // Options live on the slot's day; default their times to the slot's.
            _fDateStr = slot.CampDay.ToString("yyyy-MM-dd");
            if (string.IsNullOrWhiteSpace(_fStartStr) || _editingId == Guid.Empty)
            {
                _fStartStr = slot.StartTime.ToString("h:mm tt");
                _fEndStr   = slot.EndTime?.ToString("h:mm tt") ?? "";
            }
        }
    }
    private List<AssignmentFormRow> _fAssignments = new();
    private bool _assignmentsExpanded;
    private string _error = "";
    private string? _lightboxSrc;
    private string? _copyingFromTitle;
    private bool _mobileFormOpen;

    private string _minDate = "";
    private string _maxDate = "";

    private string? SelectedTypeSystemName =>
        _scheduleItemTypes.FirstOrDefault(t => t.ScheduleItemTypeId == _fTypeId)?.SystemName;

    private int _assignedCount =>
        _fAssignments.Count(a => a.ActivityId.HasValue || a.LocationId.HasValue || !string.IsNullOrEmpty(a.Note));

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _userId);

        _eventId = await ActiveEventSvc.GetActiveEventIdAsync();
        var campEvent = await ActiveEventSvc.GetActiveEventAsync();
        if (campEvent is not null)
        {
            _minDate  = campEvent.EffDate.ToString("yyyy-MM-dd");
            _maxDate  = campEvent.ExpDate.ToString("yyyy-MM-dd");
            _fDateStr = _minDate;
        }

        _scheduleItemTypes = await ScheduleItemTypeSvc.GetForEventAsync(_eventId);
        _fTypeId = _scheduleItemTypes.FirstOrDefault()?.ScheduleItemTypeId ?? Guid.Empty;

        _locations  = await LocationSvc.GetAllAsync();
        _activities = await MiniGameSvc.GetActivitiesAsync(_eventId);

        using var dbGroups = DbFactory.CreateDbContext();
        _groups = await dbGroups.Groups
            .Where(g => g.EventId == _eventId)
            .OrderBy(g => g.Name)
            .ToListAsync();

        _fAssignments = _groups.Select(g => new AssignmentFormRow { GroupId = g.GroupId }).ToList();

        await Reload();
    }

    private async Task Reload()
    {
        _events  = await ScheduleSvc.GetByEventAsync(_eventId);
        _optionCounts = await RegistrationSvc.GetOptionCountsAsync(_eventId);
        _loading = false;
    }

    private void StartEdit(ScheduleItem ev)
    {
        _editingId      = ev.ScheduleItemId;
        _fTitle         = ev.Title;
        _fDesc          = ev.Description;
        _fDateStr  = ev.CampDay.ToString("yyyy-MM-dd");
        _fStartStr = ev.StartTime.ToString("h:mm tt");
        _fEndStr   = ev.EndTime?.ToString("h:mm tt") ?? "";
        _fTypeId        = ev.ScheduleItemTypeId;
        _fLocationId    = ev.LocationId;
        _fLocationOther = ev.LocationOther;
        _fActivityId    = ev.ActivityId;
        _fPresenterName = ev.PresenterName;
        _fPresenterBio  = ev.PresenterBio;
        _fTrackAttendance = ev.TrackAttendance;
        _fCheckInMode     = ev.SelfCheckInMode;
        _fIsSlot          = ev.IsBreakoutSlot;
        _fAllowSelfSignup = ev.AllowSelfSignup;
        _fParentId        = ev.ParentScheduleItemId;
        _fCapacity        = ev.MaxCapacity;
        _fAssignments = _groups.Select(g =>
        {
            var existing = ev.ItemGroups.FirstOrDefault(eg => eg.GroupId == g.GroupId);
            return new AssignmentFormRow
            {
                GroupId    = g.GroupId,
                ActivityId = existing?.ActivityId,
                LocationId = existing?.LocationId,
                Note       = existing?.Note
            };
        }).ToList();
        _assignmentsExpanded = ev.ItemGroups.Any();
        _error = "";
    }

    private void StartCopy(ScheduleItem ev)
    {
        _copyingFromTitle = ev.Title;
        _editingId        = Guid.Empty;
        _fTitle           = ev.Title;
        _fDesc            = ev.Description;
        var nextDay       = ev.CampDay.AddDays(1);
        var max           = DateOnly.TryParseExact(_maxDate, "yyyy-MM-dd", out var m) ? m : ev.CampDay;
        _fDateStr         = (nextDay <= max ? nextDay : ev.CampDay).ToString("yyyy-MM-dd");
        _fStartStr        = ev.StartTime.ToString("h:mm tt");
        _fEndStr          = ev.EndTime?.ToString("h:mm tt") ?? "";
        _fTypeId          = ev.ScheduleItemTypeId;
        _fLocationId      = ev.LocationId;
        _fLocationOther   = ev.LocationOther;
        _fActivityId      = ev.ActivityId;
        _fPresenterName   = ev.PresenterName;
        _fPresenterBio    = ev.PresenterBio;
        _fTrackAttendance = ev.TrackAttendance;
        _fCheckInMode     = ev.SelfCheckInMode;
        // Copying a slot copies just the slot. Copying an option makes another option in the same
        // slot (same day) — pick "None" to copy it to another day as a regular item.
        _fIsSlot          = ev.IsBreakoutSlot;
        _fAllowSelfSignup = ev.AllowSelfSignup;
        _fParentId        = ev.ParentScheduleItemId;
        _fCapacity        = ev.MaxCapacity;
        if (_fParentId is not null) _fDateStr = ev.CampDay.ToString("yyyy-MM-dd");
        _fAssignments     = _groups.Select(g => new AssignmentFormRow { GroupId = g.GroupId }).ToList();
        _assignmentsExpanded = false;
        _error = "";
    }

    private void CancelEdit()
    {
        _copyingFromTitle    = null;
        _editingId           = Guid.Empty;
        _fTitle              = "";
        _fDesc               = null;
        _fDateStr  = _minDate;
        _fStartStr = "";
        _fEndStr   = "";
        _fTypeId             = _scheduleItemTypes.FirstOrDefault()?.ScheduleItemTypeId ?? Guid.Empty;
        _fLocationId         = null;
        _fLocationOther      = null;
        _fActivityId         = null;
        _fPresenterName      = null;
        _fPresenterBio       = null;
        _fTrackAttendance    = false;
        _fCheckInMode        = SelfCheckInMode.ButtonAndQr;
        _fIsSlot             = false;
        _fAllowSelfSignup    = true;
        _fParentId           = null;
        _fCapacity           = null;
        _fAssignments        = _groups.Select(g => new AssignmentFormRow { GroupId = g.GroupId }).ToList();
        _assignmentsExpanded = false;
        _error               = "";
        _mobileFormOpen      = false;
    }

    private void CloseFormOverlay() => CancelEdit();

    private async Task SaveAsync()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_fTitle))    { _error = "Title is required."; return; }
        if (string.IsNullOrWhiteSpace(_fDateStr))  { _error = "Day is required."; return; }
        if (string.IsNullOrWhiteSpace(_fStartStr)) { _error = "Start time is required."; return; }
        if (_fTypeId == Guid.Empty)                { _error = "Type is required."; return; }
        if (!DateOnly.TryParseExact(_fDateStr, "yyyy-MM-dd", out var day)) { _error = "Invalid date."; return; }
        if (!DateTime.TryParse(_fStartStr, out var startDt)) { _error = "Invalid start time — try \"9:30 AM\"."; return; }
        var start = TimeOnly.FromDateTime(startDt);
        TimeOnly? end = string.IsNullOrWhiteSpace(_fEndStr) ? null
            : DateTime.TryParse(_fEndStr, out var endDt) ? TimeOnly.FromDateTime(endDt) : null;

        var assignments = _fAssignments
            .Where(a => a.ActivityId.HasValue || a.LocationId.HasValue || !string.IsNullOrEmpty(a.Note))
            .Select(a => new GroupAssignmentDto(a.GroupId, a.ActivityId, a.LocationId, a.Note))
            .ToList();

        var isPresentation = SelectedTypeSystemName == "Presentation";
        var dto = new ScheduleItemDto(
            _editingId,
            _eventId,
            day, start, end,
            _fTitle.Trim(), _fDesc,
            _fLocationId, _fActivityId, _fTypeId,
            !assignments.Any(),
            _fParentId is not null ? _fCapacity : null, assignments,
            isPresentation ? _fPresenterName : null,
            isPresentation ? _fPresenterBio  : null,
            string.IsNullOrWhiteSpace(_fLocationOther) ? null : _fLocationOther.Trim(),
            !_fIsSlot && _fTrackAttendance,
            _fCheckInMode,
            _fIsSlot,
            _fAllowSelfSignup,
            _fIsSlot ? null : _fParentId
        );
        var isCopy = !string.IsNullOrEmpty(_copyingFromTitle);
        try
        {
            await ScheduleSvc.UpsertAsync(dto, _userId);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            return;
        }
        Snackbar.Add(isCopy ? $"Copied as {_fTitle.Trim()}." : _editingId == Guid.Empty ? $"{_fTitle} added." : $"{_fTitle} updated.", Severity.Success);
        CancelEdit();
        await Reload();
    }

    private async Task DeleteAsync(ScheduleItem ev)
    {
        var message = "Delete this schedule item?";
        if (ev.IsBreakoutSlot)
        {
            var (options, signUps) = await ScheduleSvc.GetSlotDeleteImpactAsync(ev.ScheduleItemId);
            if (options > 0)
                message = $"Delete the breakout slot \"{ev.Title}\"? This also deletes its {options} option{(options == 1 ? "" : "s")}, {signUps} sign-up{(signUps == 1 ? "" : "s")}, and their check-ins.";
        }
        if (!await JS.InvokeAsync<bool>("confirm", message)) return;
        await ScheduleSvc.DeleteAsync(ev.ScheduleItemId);
        Snackbar.Add($"{ev.Title} deleted.", Severity.Info);
        await Reload();
    }

    private static string DisplayItemType(ScheduleItemType? t) => t?.Name ?? "—";

    private static string ItemTypeBadgeColor(string? badgeColor, string? systemName) =>
        !string.IsNullOrEmpty(badgeColor) ? badgeColor : systemName switch
        {
            "Activity"     => "#8E44AD",
            "Meal"         => "#E67E22",
            "Travel"       => "#2980B9",
            "Free"         => "#27AE60",
            "Mandatory"    => "#D12B2B",
            "Presentation" => "#16A085",
            "Meeting"      => "#566573",
            "Task"         => "#D35400",
            _              => "#607D8B"
        };

    private class AssignmentFormRow
    {
        public Guid    GroupId    { get; set; }
        public Guid?   ActivityId { get; set; }
        public Guid?   LocationId { get; set; }
        public string? Note       { get; set; }
    }
}

        !string.IsNullOrEmpty(badgeColor) ? badgeColor : systemName switch
        {
            "Activity"     => "#8E44AD",
            "Meal"         => "#E67E22",
            "Travel"       => "#2980B9",
            "Free"         => "#27AE60",
            "Mandatory"    => "#D12B2B",
            "Presentation" => "#16A085",
            "Meeting"      => "#566573",
            "Task"         => "#D35400",
            _              => "#607D8B"
        };


@page "/admin/event-staff"
@attribute [Authorize(Roles = "Admin")]
@inject EventStaffService EventStaffSvc
@inject ActiveEventService ActiveEventSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Named EventStaffAdmin to avoid clashing with the EventStaff entity. *@

<PageTitle>Event Staff — Camp Clot Not</PageTitle>

<div style="padding: 0 16px 100px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:6px">
        <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0"><img src="/img/icons/people.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Event Staff</h2>
        @if (_event is not null)
        {
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button class="ccn-btn" @onclick="OpenAdd">+ Add</button>
                <button class="ccn-btn" style="background:transparent" @onclick="AddAllAsync">Add all active users</button>
            </div>
        }
    </div>
    @if (_event is not null)
    {
        <p style="font-size:13px;color:var(--text-mid);margin:0 0 18px">
            Staff at <strong>@_event.Name</strong>. Rosters, sign-up lists, and "all staff" mean these people.
            The role here is a label for this event only — sign-in permissions still come from <a href="/admin/users" style="color:var(--black);font-weight:700">Users</a>.
        </p>
    }

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_event is null)
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No active event. Mark one active on <a href="/admin/events">Events</a>.</p>
    }
    else
    {
        <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
            <input type="text" @bind="_search" @bind:event="oninput" placeholder="Search name or email…"
                   style="flex:1;min-width:160px;padding:8px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            <select @bind="_roleFilter"
                    style="padding:8px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;cursor:pointer">
                <option value="">All roles</option>
                @foreach (var r in _roles)
                {
                    <option value="@r.UserRoleId">@r.Name</option>
                }
            </select>
        </div>

        @if (!_staff.Any())
        {
            <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">Nobody is on this event's staff yet. Use "+ Add" or "Add all active users".</p>
        }
        else
        {
            <div style="font-size:12px;font-weight:700;color:var(--text-mid);margin-bottom:8px">@Filtered.Count() of @_staff.Count</div>
            <div style="border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);overflow-x:auto">
                <table style="width:100%;border-collapse:collapse;min-width:560px">
                    <thead>
                        <tr style="background:var(--black)">
                            <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Name</th>
                            <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Email</th>
                            <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Role at this event</th>
                            @if (_groups.Any())
                            {
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Group</th>
                            }
                            <th style="padding:10px 14px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Filtered)
                        {
                            <tr style="border-bottom:2px solid #E8E0CC">
                                <td style="padding:10px 14px;font-size:13px;font-weight:700">@s.User.FirstName @s.User.LastName</td>
                                <td style="padding:10px 14px;font-size:12px;color:var(--text-mid);overflow-wrap:anywhere">@s.User.Email</td>
                                <td style="padding:8px 14px">
                                    <select value="@s.UserRoleId" @onchange="e => ChangeRoleAsync(s, e.Value?.ToString())" style="@SelectStyle">
                                        @foreach (var r in _roles)
                                        {
                                            <option value="@r.UserRoleId">@r.Name</option>
                                        }
                                    </select>
                                </td>
                                @if (_groups.Any())
                                {
                                    <td style="padding:8px 14px">
                                        <select value="@(s.GroupId?.ToString() ?? "")" @onchange="e => ChangeGroupAsync(s, e.Value?.ToString())" style="@SelectStyle">
                                            <option value="">— None —</option>
                                            @foreach (var g in _groups)
                                            {
                                                <option value="@g.GroupId">@g.Name</option>
                                            }
                                        </select>
                                    </td>
                                }
                                <td style="padding:8px 10px;text-align:right">
                                    <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:#D12B2B;color:white" @onclick="() => RemoveAsync(s)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_addOpen)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.65);z-index:1300;display:flex;align-items:center;justify-content:center;padding:20px;animation:fadeIn .2s ease"
         @onclick="() => _addOpen = false">
        <div class="ccn-panel" style="width:min(440px,100%);max-height:80vh;display:flex;flex-direction:column;padding:20px;animation:popIn .25s ease;box-shadow:8px 8px 0 var(--black)"
             @onclick:stopPropagation="true">
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;margin:0 0 12px">Add to @_event?.Name</h3>
            <input type="text" @bind="_addSearch" @bind:event="oninput" placeholder="Search users…"
                   style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;margin-bottom:10px" />
            <div style="overflow-y:auto;flex:1;min-height:0">
                @if (!AddableFiltered.Any())
                {
                    <p style="font-size:13px;color:var(--text-light);font-weight:700">Every active user is already on this event's staff.</p>
                }
                @foreach (var u in AddableFiltered)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 0;border-bottom:2px solid #E8E0CC">
                        <div style="min-width:0">
                            <div style="font-weight:700;font-size:14px">@u.FirstName @u.LastName</div>
                            <div style="font-size:11px;color:var(--text-mid)">@u.UserRole.Name · @u.Email</div>
                        </div>
                        <button class="ccn-btn" style="font-size:11px;padding:4px 12px;flex-shrink:0" @onclick="() => AddAsync(u)">Add</button>
                    </div>
                }
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:12px">
                <button class="ccn-btn" @onclick="() => _addOpen = false">Done</button>
            </div>
        </div>
    </div>
}

@code {
    private const string SelectStyle = "padding:6px 10px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;cursor:pointer";

    private Event? _event;
    private List<EventStaff> _staff = [];
    private List<UserRole> _roles = [];
    private List<Group> _groups = [];
    private List<User> _addable = [];
    private bool _loading = true;
    private string _search = "";
    private string _roleFilter = "";
    private bool _addOpen;
    private string _addSearch = "";

    private IEnumerable<EventStaff> Filtered => _staff
        .Where(s => string.IsNullOrWhiteSpace(_search)
            || $"{s.User.FirstName} {s.User.LastName}".Contains(_search, StringComparison.OrdinalIgnoreCase)
            || s.User.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(s => string.IsNullOrEmpty(_roleFilter) || s.UserRoleId.ToString() == _roleFilter);

    private IEnumerable<User> AddableFiltered => _addable
        .Where(u => string.IsNullOrWhiteSpace(_addSearch)
            || $"{u.FirstName} {u.LastName}".Contains(_addSearch, StringComparison.OrdinalIgnoreCase)
            || u.Email.Contains(_addSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _event = await ActiveEventSvc.GetActiveEventAsync();
        if (_event is not null)
        {
            _roles  = await EventStaffSvc.GetRolesAsync();
            _groups = await EventStaffSvc.GetGroupsAsync(_event.EventId);
            await ReloadAsync();
        }
        _loading = false;
    }

    private async Task ReloadAsync() => _staff = await EventStaffSvc.GetForEventAsync(_event!.EventId);

    private async Task OpenAdd()
    {
        _addable = await EventStaffSvc.GetAddableUsersAsync(_event!.EventId);
        _addSearch = "";
        _addOpen = true;
    }

    private async Task AddAsync(User u)
    {
        await EventStaffSvc.AddAsync(_event!.EventId, u.UserId, u.UserRoleId);
        _addable.Remove(u);
        await ReloadAsync();
        Snackbar.Add($"{u.FirstName} {u.LastName} added.", Severity.Success);
    }

    private async Task AddAllAsync()
    {
        var added = await EventStaffSvc.AddAllActiveUsersAsync(_event!.EventId);
        await ReloadAsync();
        Snackbar.Add(added == 0 ? "Everyone is already on the staff list." : $"Added {added} {(added == 1 ? "person" : "people")}.", Severity.Success);
    }

    private async Task ChangeRoleAsync(EventStaff s, string? value)
    {
        if (!Guid.TryParse(value, out var roleId)) return;
        await EventStaffSvc.UpdateAsync(s.EventStaffId, roleId, s.GroupId);
        await ReloadAsync();
    }

    private async Task ChangeGroupAsync(EventStaff s, string? value)
    {
        Guid? groupId = Guid.TryParse(value, out var gid) ? gid : null;
        await EventStaffSvc.UpdateAsync(s.EventStaffId, s.UserRoleId, groupId);
        await ReloadAsync();
    }

    private async Task RemoveAsync(EventStaff s)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove {s.User.FirstName} {s.User.LastName} from {_event!.Name} staff? Their check-ins and sign-ups are kept.")) return;
        await EventStaffSvc.RemoveAsync(s.EventStaffId);
        await ReloadAsync();
        Snackbar.Add("Removed.", Severity.Info);
    }
}

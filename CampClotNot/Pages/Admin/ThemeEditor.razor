@page "/admin/theme"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ActiveEventService ActiveEventSvc
@inject ThemeAdminService ThemeAdmin
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using Microsoft.EntityFrameworkCore
@using System.Text.RegularExpressions

<PageTitle>Theme — Camp Clot Not</PageTitle>

<style>
    .thm-label { font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px }
    .thm-input { width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box }
    .thm-hint  { font-size:11px;color:var(--text-light);margin-top:3px }
    .thm-err   { font-size:11px;color:#D12B2B;margin-top:3px;font-weight:700 }
    .thm-color-row { display:flex;align-items:center;gap:8px;margin-bottom:10px }
    .thm-color-row input[type=color] { width:40px;height:36px;padding:0;border:var(--panel-border);border-radius:6px;background:none;cursor:pointer;flex-shrink:0 }
    .thm-color-row .thm-input { width:110px;flex-shrink:0;font-family:monospace }
    .thm-grid { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:start }
    @@media (max-width: 899px) { .thm-grid { grid-template-columns:minmax(0,1fr) } }
    .thm-img-box { display:flex;align-items:center;justify-content:center;min-height:64px;background:var(--black);border-radius:8px;padding:8px;margin-bottom:8px }
</style>

<div style="padding: 0 16px 100px">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0 0 20px">🎨 Theme</h2>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_state is null)
    {
        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No event found. <a href="/admin/events">Create one on Events →</a></p>
    }
    else
    {
        @* ── Header: event picker ── *@
        <div class="ccn-panel" style="padding:14px 16px;margin-bottom:20px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end">
            <div style="flex:1;min-width:220px">
                <div class="thm-label">Event</div>
                <select class="thm-input" style="cursor:pointer" value="@_eventId.ToString()" @onchange="OnEventChanged">
                    @foreach (var ev in _events)
                    {
                        <option value="@ev.EventId">@ev.Name@(ev.IsActive ? " (active)" : "")</option>
                    }
                </select>
            </div>
            <div style="font-size:12px;color:var(--text-light);padding-bottom:4px">
                @(_state.UpdatedAt is { } u ? $"Last edited {CampTime.FromUtc(u):MMM d, h:mm tt}" : "Not edited yet")
                · <a href="/admin/events" style="color:var(--text-mid);font-weight:700">Back to Events</a>
            </div>
        </div>

        <div class="thm-grid">
            <div>
                @* ── Branding ── *@
                <div class="ccn-panel" style="padding:20px;margin-bottom:20px">
                    <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0 0 16px">Branding</h3>

                    <div style="margin-bottom:14px">
                        <div class="thm-label">App title</div>
                        <input class="thm-input" maxlength="60" value="@_title" @oninput='e => _title = e.Value?.ToString() ?? ""' />
                        <div class="thm-hint">Shown as the nav wordmark when there's no logo, and in image alt text.</div>
                    </div>
                    <div style="margin-bottom:18px">
                        <div class="thm-label">Nav subtitle</div>
                        <input class="thm-input" maxlength="40" value="@_subtitle" @oninput='e => _subtitle = e.Value?.ToString() ?? ""' />
                        <div class="thm-hint">The small line under the logo in the header.</div>
                    </div>

                    <div style="margin-bottom:18px">
                        <div class="thm-label">Nav logo</div>
                        <div class="thm-img-box">
                            @if (_state.LogoUrl is { } logo)
                            {
                                <img src="@logo" alt="" style="max-height:48px;max-width:100%;object-fit:contain" />
                            }
                            else
                            {
                                <span style="color:#fff;font-size:12px;font-weight:700">@(_base.UseCcnArtwork ? "Using the Camp Clot Not logo" : "No logo — the title is shown as text")</span>
                            }
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                            <InputFile OnChange="e => UploadAsync(e, logo: true)" accept=".png,.jpg,.jpeg,.webp" style="font-size:13px;font-family:'Nunito',sans-serif;max-width:100%" />
                            @if (_state.LogoUrl is not null)
                            {
                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => RemoveAsync(logo: true)">Remove</button>
                            }
                        </div>
                        <div class="thm-hint">Wide, transparent PNG or WebP works best (shown ~42px tall on a dark band). PNG, JPEG, or WebP, up to 2 MB.</div>
                        @if (!string.IsNullOrEmpty(_logoError)) { <div class="thm-err">@_logoError</div> }
                    </div>

                    <div>
                        <div class="thm-label">Dashboard banner</div>
                        <div class="thm-img-box" style="background:var(--bg-base)">
                            @if (_state.BannerUrl is { } banner)
                            {
                                <img src="@banner" alt="" style="max-height:120px;max-width:100%;object-fit:contain;border-radius:6px" />
                            }
                            else
                            {
                                <span style="font-size:12px;font-weight:700;color:var(--text-light)">No banner — the Dashboard shows the logo</span>
                            }
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                            <InputFile OnChange="e => UploadAsync(e, logo: false)" accept=".png,.jpg,.jpeg,.webp" style="font-size:13px;font-family:'Nunito',sans-serif;max-width:100%" />
                            @if (_state.BannerUrl is not null)
                            {
                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => RemoveAsync(logo: false)">Remove</button>
                            }
                        </div>
                        <div class="thm-hint">A flyer or photo for the top of the Dashboard. PNG, JPEG, or WebP, up to 2 MB.</div>
                        @if (!string.IsNullOrEmpty(_bannerError)) { <div class="thm-err">@_bannerError</div> }
                    </div>
                </div>

                @* ── Look ── *@
                <div class="ccn-panel" style="padding:20px;margin-bottom:20px">
                    <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0 0 16px">Look</h3>

                    <div style="margin-bottom:18px">
                        <div class="thm-label">Start from a preset</div>
                        <div style="display:flex;gap:6px">
                            <select class="thm-input" style="flex:1;cursor:pointer" value="@_presetKey" @onchange="e => _presetKey = e.Value?.ToString() ?? _presetKey">
                                @foreach (var p in ThemePresets.All)
                                {
                                    <option value="@p.Key">@p.Name</option>
                                }
                            </select>
                            <button class="ccn-btn" style="font-size:12px;padding:6px 12px;flex-shrink:0" @onclick="ApplyPresetAsync">Apply</button>
                        </div>
                        <div class="thm-hint">@(ThemePresets.Get(_presetKey)?.Description). Replaces colors, font, and borders; keeps your title, subtitle, logo, and banner.</div>
                    </div>

                    <div class="thm-label" style="margin-bottom:10px">Colors</div>
                    @foreach (var c in ColorFields)
                    {
                        <div class="thm-color-row">
                            <input type="color" value="@(IsHex(_colors[c.Key]) ? _colors[c.Key] : "#000000")" @oninput="e => _colors[c.Key] = e.Value?.ToString() ?? _colors[c.Key]" />
                            <input class="thm-input" value="@_colors[c.Key]" @onchange='e => _colors[c.Key] = (e.Value?.ToString() ?? "").Trim()' />
                            <div style="min-width:0">
                                <div style="font-size:13px;font-weight:800">@c.Label</div>
                                <div class="thm-hint" style="margin-top:0">@c.Hint</div>
                                @if (!IsHex(_colors[c.Key])) { <div class="thm-err" style="margin-top:0">Use #RRGGBB</div> }
                            </div>
                        </div>
                    }

                    <div style="margin:16px 0 14px">
                        <div class="thm-label">Heading font</div>
                        <select class="thm-input" style="cursor:pointer" value="@_font" @onchange="e => _font = e.Value?.ToString() ?? _font">
                            @foreach (var f in FontOptionsFor(_font))
                            {
                                <option value="@f.Value">@f.Label</option>
                            }
                        </select>
                    </div>

                    <div style="margin-bottom:14px">
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;cursor:pointer">
                            <input type="checkbox" checked="@_dots" @onchange="() => _dots = !_dots" /> Dot pattern background
                        </label>
                        @if (_dots)
                        {
                            <div class="thm-color-row" style="margin-top:8px">
                                <input type="color" value="@(IsHex(_colors["BgDot"]) ? _colors["BgDot"] : "#000000")" @oninput='e => _colors["BgDot"] = e.Value?.ToString() ?? _colors["BgDot"]' />
                                <input class="thm-input" value="@(_colors["BgDot"])" @onchange='e => _colors["BgDot"] = (e.Value?.ToString() ?? "").Trim()' />
                                <div style="font-size:13px;font-weight:800">Dot color</div>
                            </div>
                            @if (!IsHex(_colors["BgDot"])) { <div class="thm-err">Dot color: use #RRGGBB</div> }
                        }
                    </div>

                    <div>
                        <div class="thm-label">Border style</div>
                        <div style="display:flex;gap:16px;margin-bottom:8px">
                            <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;cursor:pointer">
                                <input type="radio" name="thm-border" checked="@_bold" @onchange="() => _bold = true" /> Bold (thick black, hard shadow)
                            </label>
                            <label style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;cursor:pointer">
                                <input type="radio" name="thm-border" checked="@(!_bold)" @onchange="() => _bold = false" /> Soft
                            </label>
                        </div>
                        @if (!_bold)
                        {
                            <div class="thm-color-row">
                                <input type="color" value="@(IsHex(_colors["BorderColor"]) ? _colors["BorderColor"] : "#000000")" @oninput='e => _colors["BorderColor"] = e.Value?.ToString() ?? _colors["BorderColor"]' />
                                <input class="thm-input" value="@(_colors["BorderColor"])" @onchange='e => _colors["BorderColor"] = (e.Value?.ToString() ?? "").Trim()' />
                                <div style="font-size:13px;font-weight:800">Border color</div>
                            </div>
                            @if (!IsHex(_colors["BorderColor"])) { <div class="thm-err">Border color: use #RRGGBB</div> }
                        }
                    </div>
                </div>
            </div>

            @* ── Live preview + save ── *@
            <div style="position:sticky;top:12px">
                <div class="ccn-panel" style="padding:16px;margin-bottom:16px">
                    <div class="thm-label" style="margin-bottom:10px">Preview</div>
                    <div style="@PreviewVars;border-radius:10px;overflow:hidden;border:2px solid #1A1A1A">
                        <div style="background:var(--black);border-bottom:4px solid var(--color-primary);height:72px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2px;padding:0 10px">
                            @if (PreviewLogo is { } pl)
                            {
                                <img src="@pl" alt="" style="height:36px;width:auto;max-width:220px;object-fit:contain" />
                            }
                            else
                            {
                                <span style="font-family:var(--font-display);font-weight:700;font-size:18px;color:#fff;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@_title</span>
                            }
                            @if (PreviewLogo is not null || !string.Equals(_subtitle.Trim(), _title.Trim(), StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="font-family:var(--font-display);font-weight:700;font-size:10px;color:var(--color-primary);letter-spacing:2px;text-transform:uppercase;line-height:1">@_subtitle</span>
                            }
                        </div>
                        <div style="background-color:var(--bg-base);background-image:var(--bg-dot-image);background-size:22px 22px;padding:16px;font-family:'Nunito',sans-serif;color:var(--text-dark)">
                            <div style="background:var(--color-primary);border:var(--panel-border);border-radius:12px;box-shadow:var(--panel-shadow);padding:16px;text-align:center;margin-bottom:14px">
                                @if (_state.BannerUrl is { } pb)
                                {
                                    <img src="@pb" alt="" style="max-width:160px;width:100%;height:auto;border-radius:8px;border:var(--panel-border);margin-bottom:8px" />
                                }
                                else if (PreviewLogo is { } pbl)
                                {
                                    <img src="@pbl" alt="" style="height:44px;width:auto;max-width:100%;object-fit:contain;margin-bottom:8px" />
                                }
                                <div style="font-family:var(--font-display);font-weight:700;font-size:18px;color:var(--black)">Welcome to @_state.EventName</div>
                            </div>
                            <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:var(--panel-shadow);padding:14px;margin-bottom:14px">
                                <div style="font-family:var(--font-display);font-weight:700;font-size:15px;margin-bottom:4px">Today's schedule</div>
                                <div style="font-size:13px;color:var(--text-mid);margin-bottom:2px">9:00 AM · Opening session</div>
                                <div style="font-size:12px;color:var(--text-light)">Main Hall</div>
                            </div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                                <span style="font-family:var(--font-display);font-weight:700;font-size:13px;padding:8px 16px;border-radius:7px;border:var(--panel-border);box-shadow:var(--panel-shadow);background:var(--panel-bg);color:var(--text-dark)">Button</span>
                                <span style="font-size:10px;font-weight:800;color:#fff;background:var(--color-accent);padding:3px 8px;border-radius:4px">Urgent</span>
                                <span style="font-size:10px;font-weight:800;color:#fff;background:var(--color-success);padding:3px 8px;border-radius:4px">Checked in</span>
                                <span style="font-size:10px;font-weight:800;color:#fff;background:var(--color-info);padding:3px 8px;border-radius:4px">Info</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ccn-panel" style="padding:16px">
                    @if (!IsValid)
                    {
                        <div class="thm-err" style="margin:0 0 10px">Fix the highlighted colors before saving.</div>
                    }
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="ccn-btn" disabled="@(!IsValid || _saving)" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save Theme")</button>
                        @if (_savedActive)
                        {
                            <button class="ccn-btn" style="background:transparent" @onclick='() => Nav.NavigateTo(Nav.Uri, forceLoad: true)'>Reload to see it</button>
                        }
                    </div>
                    <div class="thm-hint" style="margin-top:8px">Changes reach everyone on their next page load. Logo and banner uploads save immediately.</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "eventId")] public Guid? EventIdParam { get; set; }

    private record ColorField(string Key, string Label, string Hint);

    private static readonly ColorField[] ColorFields =
    [
        new("Primary",   "Primary",          "Header underline, Dashboard banner, highlights"),
        new("Accent",    "Accent",           "Urgent badges, stars, danger"),
        new("Success",   "Success",          "Confirmations, check-ins"),
        new("Info",      "Info",             "Informational badges"),
        new("BgBase",    "Page background",  "Behind everything"),
        new("PanelBg",   "Panel background", "Cards, forms, buttons"),
        new("TextDark",  "Text (dark)",      "Headings and body text"),
        new("TextMid",   "Text (mid)",       "Secondary text"),
        new("TextLight", "Text (light)",     "Hints and labels"),
    ];

    private static readonly (string Value, string Label)[] Fonts =
    [
        ("'Fredoka One', cursive", "Fredoka One (playful)"),
        ("'Poppins', sans-serif",  "Poppins (clean)"),
        ("'Nunito', sans-serif",   "Nunito (friendly)"),
    ];

    // Soft shadow used when switching a Bold theme to Soft; a theme that's already Soft keeps its own.
    private const string DefaultSoftShadow = "0 4px 14px rgba(0,0,0,0.14)";
    private const string BoldBorderColor = "#1A1A1A";
    private const string BoldShadow = "4px 4px 0 #1A1A1A";

    private static readonly Regex HexRx = new("^#[0-9A-Fa-f]{6}$");
    private static bool IsHex(string? v) => v is not null && HexRx.IsMatch(v);

    private bool _loading = true;
    private bool _saving;
    private bool _savedActive;
    private List<Event> _events = new();
    private Guid _eventId;
    private ThemeEditState? _state;

    // Draft. _base holds the loaded config so fields the editor doesn't expose (board
    // colors, currency names, banner path) survive a save.
    private ThemeConfig _base = ThemeService.Default;
    private string _title = "";
    private string _subtitle = "";
    private Dictionary<string, string> _colors = new();
    private string _font = "";
    private bool _dots;
    private bool _bold;
    private string _presetKey = ThemePresets.Classic.Key;
    private string _logoError = "";
    private string _bannerError = "";

    private bool IsValid =>
        ColorFields.All(c => IsHex(_colors[c.Key]))
        && (!_dots || IsHex(_colors["BgDot"]))
        && (_bold || IsHex(_colors["BorderColor"]));

    protected override async Task OnInitializedAsync()
    {
        using (var db = DbFactory.CreateDbContext())
            _events = await db.Events.AsNoTracking().OrderByDescending(e => e.EffDate).ToListAsync();

        var active = await ActiveEventSvc.GetActiveEventAsync();
        _eventId = EventIdParam is { } q && _events.Any(e => e.EventId == q) ? q
                 : active?.EventId ?? _events.FirstOrDefault()?.EventId ?? Guid.Empty;
        await LoadAsync();
        _loading = false;
    }

    private async Task OnEventChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        _eventId = id;
        _savedActive = false;
        await LoadAsync();
        Nav.NavigateTo($"/admin/theme?eventId={id}", replace: true);
    }

    private async Task LoadAsync()
    {
        _state = _eventId == Guid.Empty ? null : await ThemeAdmin.GetForEventAsync(_eventId);
        _logoError = _bannerError = "";
        if (_state is null) return;
        _title = _state.Config.AppTitle;
        _subtitle = _state.Config.AppSubtitle;
        LoadLook(_state.Config);
    }

    private void LoadLook(ThemeConfig c)
    {
        _base = c;
        _colors = new()
        {
            ["Primary"] = c.Primary, ["Accent"] = c.Accent, ["Success"] = c.Success, ["Info"] = c.Info,
            ["BgBase"] = c.BgBase, ["PanelBg"] = c.PanelBg,
            ["TextDark"] = c.TextDark, ["TextMid"] = c.TextMid, ["TextLight"] = c.TextLight,
            ["BgDot"] = c.BgDot, ["BorderColor"] = c.BorderColor,
        };
        _font = c.HeadingFont;
        _dots = c.UseDotPattern;
        _bold = c.BorderWidth == "3px";
    }

    private static IEnumerable<(string Value, string Label)> FontOptionsFor(string current) =>
        Fonts.Any(f => f.Value == current) ? Fonts : Fonts.Prepend((current, $"Current ({current})"));

    private ThemeConfig BuildDraft()
    {
        var baseIsBold = _base.BorderWidth == "3px";
        return _base with
        {
            AppTitle      = _title.Trim(),
            AppSubtitle   = _subtitle.Trim(),
            Primary       = _colors["Primary"],
            Accent        = _colors["Accent"],
            Success       = _colors["Success"],
            Info          = _colors["Info"],
            BgBase        = _colors["BgBase"],
            PanelBg       = _colors["PanelBg"],
            TextDark      = _colors["TextDark"],
            TextMid       = _colors["TextMid"],
            TextLight     = _colors["TextLight"],
            BgDot         = _colors["BgDot"],
            UseDotPattern = _dots,
            HeadingFont   = _font,
            BorderWidth   = _bold ? "3px" : "1.5px",
            BorderColor   = _bold ? BoldBorderColor : _colors["BorderColor"],
            PanelShadow   = _bold ? (baseIsBold ? _base.PanelShadow : BoldShadow)
                                  : (baseIsBold ? DefaultSoftShadow : _base.PanelShadow)
        };
    }

    // Custom properties cascade, so setting them on the preview wrapper themes only the preview.
    private string PreviewVars => BuildDraft().CssVariables.Replace("\r", " ").Replace("\n", " ");

    private string? PreviewLogo =>
        _state?.LogoUrl ?? (_base.UseCcnArtwork ? "/img/ccn-logo-nav.webp" : null);

    private async Task ApplyPresetAsync()
    {
        if (ThemePresets.Get(_presetKey) is not { } preset) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Replace colors, font, and borders with the {preset.Name} preset? Title, subtitle, logo, and banner are kept. Nothing is saved until you click Save Theme."))
            return;
        LoadLook(preset.Config with
        {
            AppTitle = _title,
            AppSubtitle = _subtitle,
            BannerAssetPath = _base.BannerAssetPath
        });
    }

    private async Task SaveAsync()
    {
        if (_state is null || !IsValid) return;
        _saving = true;
        var draft = BuildDraft();
        await ThemeAdmin.SaveConfigAsync(_state.ThemeId, draft);
        _base = draft;
        _state = await ThemeAdmin.GetForEventAsync(_eventId);
        _saving = false;
        _savedActive = _events.FirstOrDefault(e => e.EventId == _eventId)?.IsActive == true;
        Snackbar.Add(_savedActive ? "Theme saved. Reload to see it everywhere." : "Theme saved.", Severity.Success);
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, bool logo)
    {
        if (_state is null) return;
        if (logo) _logoError = ""; else _bannerError = "";
        var file = e.File;
        var check = ThemeAdminService.Validate(file.Size, file.ContentType);
        if (check != ImageUploadResult.Ok)
        {
            var msg = check == ImageUploadResult.TooLarge ? "File too large — maximum 2 MB." : "Use a PNG, JPEG, or WebP image.";
            if (logo) _logoError = msg; else _bannerError = msg;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: ThemeAdminService.MaxImageBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        if (logo) await ThemeAdmin.SetLogoAsync(_state.ThemeId, ms.ToArray(), file.ContentType);
        else      await ThemeAdmin.SetBannerAsync(_state.ThemeId, ms.ToArray(), file.ContentType);

        await RefreshImagesAsync();
        Snackbar.Add(logo ? "Logo uploaded." : "Banner uploaded.", Severity.Success);
    }

    private async Task RemoveAsync(bool logo)
    {
        if (_state is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", logo ? "Remove this event's logo?" : "Remove this event's Dashboard banner?"))
            return;
        if (logo) await ThemeAdmin.ClearLogoAsync(_state.ThemeId);
        else
        {
            await ThemeAdmin.ClearBannerAsync(_state.ThemeId);
            _base = _base with { BannerAssetPath = null };   // keep a later Save from restoring it
        }
        await RefreshImagesAsync();
    }

    // Re-read image URLs/UpdatedAt without discarding unsaved draft edits.
    private async Task RefreshImagesAsync()
    {
        _state = await ThemeAdmin.GetForEventAsync(_eventId);
        _savedActive = _events.FirstOrDefault(e => e.EventId == _eventId)?.IsActive == true;
    }
}

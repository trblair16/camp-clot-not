@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject AuthService AuthSvc
@inject ActiveEventService ActiveEventSvc
@inject EventStaffService EventStaffSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PasswordResetService Resets
@inject IEmailSender Email
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject IConfiguration Config
@using CampClotNot.Data.Entities

<PageTitle>Accounts — Camp Clot Not</PageTitle>

<style>
    @@media (max-width: 699px) {
        .admin-usr-form        { display: none; }
        .admin-usr-table       { display: none; }
        .admin-usr-cards       { display: flex; flex-direction: column; gap: 10px; }
        .admin-usr-add-mobile  { display: block; margin-bottom: 12px; }
    }
    @@media (min-width: 700px) {
        .admin-usr-cards      { display: none; }
        .admin-usr-add-mobile { display: none; }
    }
</style>

<div style="padding: 0 16px 100px">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0 0 20px"><img src="/img/icons/key.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Accounts</h2>
    <p style="font-size:13px;color:var(--text-mid);margin:-12px 0 18px;max-width:760px">
        Sign-in accounts for staff and volunteers: passwords, deactivation, and what someone can do in the app.
        To put people on an event, use <a href="/admin/team" style="color:var(--black);font-weight:700">Team</a> — it can create accounts too.
    </p>

    <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">

        @* ── Create Account form (desktop) / mobile overlay ── *@
        <div style="@(_mobileFormOpen ? "position:fixed;inset:0;background:rgba(26,26,26,.65);z-index:100;overflow-y:auto;display:flex;align-items:flex-start;justify-content:center;padding:16px;animation:fadeIn .15s ease" : "display:contents")"
             @onclick="CloseCreateOverlay">
        <div class="admin-usr-form" style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:@(_mobileFormOpen ? "8px 8px 0 var(--border-color)" : "4px 4px 0 var(--border-color)");padding:20px;flex:0 0 320px;min-width:260px;@(_mobileFormOpen ? "display:block !important;max-width:480px;width:100%;margin:auto;animation:popIn .2s ease" : "")"
             @onclick:stopPropagation>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
                <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0">Create Account</h3>
                @if (_mobileFormOpen)
                {
                    <button @onclick="CloseCreateOverlay" style="background:none;border:none;font-size:22px;cursor:pointer;line-height:1;color:var(--text-light);padding:0">✕</button>
                }
            </div>

            <div style="display:flex;gap:10px;margin-bottom:14px">
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">First Name</div>
                    <input type="text" @bind="_form.FirstName" placeholder="First"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Last Name</div>
                    <input type="text" @bind="_form.LastName" placeholder="Last"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Email</div>
                <input type="email" @bind="_form.Email" placeholder="you@example.com"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Password</div>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:4px">
                    <input type="radio" name="usr-pw-mode" checked="@_form.SendInvite" @onchange="() => _form.SendInvite = true" />
                    @(Email.IsConfigured ? "Email an invite link" : "Create an invite link")
                </label>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;cursor:pointer">
                    <input type="radio" name="usr-pw-mode" checked="@(!_form.SendInvite)" @onchange="() => _form.SendInvite = false" />
                    Set a temporary password
                </label>
                @if (_form.SendInvite)
                {
                    <div style="font-size:11px;color:var(--text-light);margin-top:4px">
                        @(Email.IsConfigured
                            ? "They'll get an email to choose their own password (link valid 7 days)."
                            : "Email isn't set up yet — you'll get a link to send them yourself (valid 7 days).")
                    </div>
                }
            </div>

            @if (!_form.SendInvite)
            {
            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Temporary Password</div>
                <div style="position:relative">
                    <input type="@(_showCreatePw ? "text" : "password")" @bind="_form.Password" placeholder="••••••••"
                           style="width:100%;padding:9px 40px 9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                    <button type="button" @onclick="() => _showCreatePw = !_showCreatePw"
                            style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:16px;padding:0;line-height:1;color:var(--text-light)">
                        @(_showCreatePw ? "🙈" : "👁")
                    </button>
                </div>
            </div>
            }

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Role</div>
                <select value="@_form.Role.ToString()"
                        @onchange="e => _form.Role = Enum.Parse<Role>(e.Value?.ToString() ?? nameof(Role.Staff))"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;cursor:pointer">
                    <option value="Staff">Staff</option>
                    <option value="Volunteer">Volunteer / Counselor</option>
                    <option value="MedicalStaff">Medical Staff</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            @if (_activeEvent is not null)
            {
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:14px;cursor:pointer;font-size:13px;font-weight:700">
                    <input type="checkbox" checked="@_form.AddToEventStaff" @onchange="() => _form.AddToEventStaff = !_form.AddToEventStaff" />
                    Add to the @_activeEvent.Name team
                </label>
            }

            <button class="ccn-btn" style="width:100%;margin-top:4px" @onclick="CreateAsync">Create Account</button>
        </div>
        </div>

        @* ── Users table ── *@
        <div style="flex:1;min-width:260px">
            <button class="ccn-btn admin-usr-add-mobile" @onclick="() => _mobileFormOpen = true">+ Create Account</button>

            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (!_users.Any())
            {
                <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No users yet.</p>
            }
            else
            {
                @* Search / filter toolbar *@
                <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap">
                    <input type="text" @bind="_search" @bind:event="oninput" placeholder="Search name or email…"
                           style="flex:1;min-width:160px;padding:8px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                    <select @bind="_roleFilter"
                            style="padding:8px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;cursor:pointer">
                        <option value="">All roles</option>
                        <option value="Admin">Admin</option>
                        <option value="MedicalStaff">Medical Staff</option>
                        <option value="Staff">Staff</option>
                        <option value="Volunteer">Volunteer</option>
                    </select>
                </div>

                <div class="admin-usr-cards">
                    @foreach (var u in FilteredUsers)
                    {
                        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:3px 3px 0 var(--border-color);padding:12px 14px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                            <div style="flex:1;min-width:0">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap">
                                    <div style="font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--text-dark)">@u.FirstName @u.LastName</div>
                                    <span style="background:var(--black);color:white;font-family:var(--font-display);font-weight:700;font-size:11px;padding:2px 8px;border-radius:4px;flex-shrink:0">@u.UserRole.SystemName</span>
                                    @if (!u.IsActive)
                                    {
                                        <span style="background:#E67E22;color:white;font-family:var(--font-display);font-weight:700;font-size:11px;padding:2px 8px;border-radius:4px">Inactive</span>
                                    }
                                </div>
                                <div style="font-size:12px;color:var(--text-mid);overflow-wrap:break-word">@u.Email</div>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:4px;flex-shrink:0">
                                <button class="ccn-btn" style="font-size:11px;padding:4px 12px" @onclick="() => OpenEditDialog(u)">Edit</button>
                                <button class="ccn-btn" style="font-size:11px;padding:4px 12px" @onclick="() => OpenResetDialog(u)">Reset PW</button>
                                @if (u.IsActive)
                                {
                                    <button class="ccn-btn" style="font-size:11px;padding:4px 12px;background:#E67E22;color:white" @onclick="() => DeactivateAsync(u)">Deactivate</button>
                                }
                            </div>
                        </div>
                    }
                    @if (!FilteredUsers.Any())
                    {
                        <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700;font-style:italic">No users match your search.</p>
                    }
                </div>

                <div class="admin-usr-table" style="border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);overflow:hidden">
                    <div style="overflow-x:auto">
                        <table style="width:100%;border-collapse:collapse;min-width:600px">
                            <thead>
                                <tr style="background:var(--black)">
                                    <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left;cursor:pointer;user-select:none"
                                        @onclick='() => SetSort("name")'>
                                        Name @SortIndicator("name")
                                    </th>
                                    <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Email</th>
                                    <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left;cursor:pointer;user-select:none"
                                        @onclick='() => SetSort("role")'>
                                        Role @SortIndicator("role")
                                    </th>
                                    <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Active</th>
                                    <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in FilteredUsers)
                                {
                                    <tr style="border-bottom:2px solid #E8E0CC">
                                        <td style="padding:10px 14px;font-size:13px;font-weight:700">@u.FirstName @u.LastName</td>
                                        <td style="padding:10px 14px;font-size:12px;color:var(--text-mid)">@u.Email</td>
                                        <td style="padding:10px 14px">
                                            <span style="background:var(--black);color:white;font-family:var(--font-display);font-weight:700;font-size:11px;padding:2px 8px;border-radius:4px">@u.UserRole.SystemName</span>
                                        </td>
                                        <td style="padding:10px 14px;font-size:13px">@(u.IsActive ? "✓" : "—")</td>
                                        <td style="padding:8px 10px">
                                            <div style="display:flex;gap:4px;flex-wrap:wrap">
                                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => OpenEditDialog(u)">Edit</button>
                                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => OpenResetDialog(u)">Reset PW</button>
                                                @if (u.IsActive)
                                                {
                                                    <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:#E67E22;color:white" @onclick="() => DeactivateAsync(u)">Deactivate</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!FilteredUsers.Any())
                                {
                                    <tr>
                                        <td colspan="6" style="padding:16px 14px;font-size:13px;color:var(--text-light);font-style:italic">
                                            No users match your search.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@* ── Edit User modal ── *@
@if (_editOpen)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.6);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;animation:fadeIn .15s ease"
         @onclick="CloseEditDialog">
        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:12px;box-shadow:6px 6px 0 var(--border-color);padding:24px;width:100%;max-width:440px;animation:popIn .2s ease"
             @onclick:stopPropagation>
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;margin:0 0 18px">Edit User</h3>

            <div style="display:flex;gap:10px;margin-bottom:14px">
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">First Name</div>
                    <input type="text" @bind="_editForm.FirstName" placeholder="First"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
                <div style="flex:1">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Last Name</div>
                    <input type="text" @bind="_editForm.LastName" placeholder="Last"
                           style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                </div>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Email</div>
                <input type="email" @bind="_editForm.Email" placeholder="you@example.com"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Role</div>
                <select value="@_editForm.Role.ToString()"
                        @onchange="e => _editForm.Role = Enum.Parse<Role>(e.Value?.ToString() ?? nameof(Role.Staff))"
                        style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;cursor:pointer">
                    <option value="Staff">Staff</option>
                    <option value="Volunteer">Volunteer / Counselor</option>
                    <option value="MedicalStaff">Medical Staff</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            @if (_editError is not null)
            {
                <div style="background:#FEE2E2;border:2px solid #E83030;border-radius:7px;padding:8px 12px;margin-bottom:14px;font-size:13px;font-weight:700;color:#C0392B">⚠️ @_editError</div>
            }

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px">
                <button class="ccn-btn" style="background:transparent" @onclick="CloseEditDialog">Cancel</button>
                <button class="ccn-btn" @onclick="SubmitEditAsync">Save Changes</button>
            </div>
        </div>
    </div>
}

@* ── Reset Password modal ── *@
@if (_resetOpen)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.6);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;animation:fadeIn .15s ease"
         @onclick="CloseResetDialog">
        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:12px;box-shadow:6px 6px 0 var(--border-color);padding:24px;width:100%;max-width:400px;animation:popIn .2s ease"
             @onclick:stopPropagation>
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;margin:0 0 18px">Reset Password</h3>
            <p style="font-size:13px;color:var(--text-light);margin:0 0 16px">@_resetting?.FirstName @_resetting?.LastName · @_resetting?.Email</p>

            <div style="background:var(--bg-base);border:2px solid var(--border-color);border-radius:8px;padding:12px;margin-bottom:16px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">@(Email.IsConfigured ? "Email a reset link" : "Create a reset link")</div>
                <div style="font-size:12px;color:var(--text-mid);margin-bottom:8px">They choose their own password. The link works once and expires in 24 hours.</div>
                <button class="ccn-btn" style="font-size:12px;padding:6px 12px" disabled="@_linkBusy" @onclick="SendResetLinkAsync">
                    @(_linkBusy ? "Sending…" : Email.IsConfigured ? "Email Reset Link" : "Create Link")
                </button>
                @if (_resetLinkStatus is not null)
                {
                    <div style="font-size:12px;font-weight:700;margin-top:8px;color:var(--text-dark)">@_resetLinkStatus</div>
                }
                @if (_resetLink is not null)
                {
                    <div style="display:flex;gap:6px;margin-top:8px">
                        <input readonly value="@_resetLink" style="flex:1;min-width:0;padding:6px 8px;font-size:11px;font-family:monospace;border:2px solid var(--border-color);border-radius:6px;background:var(--panel-bg)" />
                        <button class="ccn-btn" style="font-size:11px;padding:4px 10px;flex-shrink:0" @onclick="() => CopyAsync(_resetLink)">Copy</button>
                    </div>
                }
            </div>

            <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px;margin-bottom:10px">Or set a temporary password</div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">New Password</div>
                <div style="position:relative">
                    <input type="@(_showResetPw ? "text" : "password")" @bind="_resetPassword" placeholder="••••••••"
                           style="width:100%;padding:9px 40px 9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                    <button type="button" @onclick="() => _showResetPw = !_showResetPw"
                            style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:16px;padding:0;line-height:1;color:var(--text-light)">
                        @(_showResetPw ? "🙈" : "👁")
                    </button>
                </div>
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Confirm Password</div>
                <div style="position:relative">
                    <input type="@(_showResetConfirm ? "text" : "password")" @bind="_resetConfirm" placeholder="••••••••"
                           style="width:100%;padding:9px 40px 9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
                    <button type="button" @onclick="() => _showResetConfirm = !_showResetConfirm"
                            style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:16px;padding:0;line-height:1;color:var(--text-light)">
                        @(_showResetConfirm ? "🙈" : "👁")
                    </button>
                </div>
            </div>

            @if (_resetError is not null)
            {
                <div style="background:#FEE2E2;border:2px solid #E83030;border-radius:7px;padding:8px 12px;margin-bottom:14px;font-size:13px;font-weight:700;color:#C0392B">⚠️ @_resetError</div>
            }

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:4px">
                <button class="ccn-btn" style="background:transparent" @onclick="CloseResetDialog">Cancel</button>
                <button class="ccn-btn" @onclick="SubmitResetAsync">Reset Password</button>
            </div>
        </div>
    </div>
}

@* ── Invite link modal (email not configured or send failed) ── *@
@if (_inviteLink is not null)
{
    <div style="position:fixed;inset:0;background:rgba(26,26,26,.6);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;animation:fadeIn .15s ease"
         @onclick="() => _inviteLink = null">
        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:12px;box-shadow:6px 6px 0 var(--border-color);padding:24px;width:100%;max-width:440px;animation:popIn .2s ease"
             @onclick:stopPropagation>
            <h3 style="font-family:var(--font-display);font-weight:700;font-size:18px;margin:0 0 10px">Send this invite link</h3>
            <p style="font-size:13px;color:var(--text-mid);margin:0 0 12px">@_inviteNote</p>
            <div style="display:flex;gap:6px;margin-bottom:16px">
                <input readonly value="@_inviteLink" style="flex:1;min-width:0;padding:6px 8px;font-size:11px;font-family:monospace;border:2px solid var(--border-color);border-radius:6px;background:var(--bg-base)" />
                <button class="ccn-btn" style="font-size:11px;padding:4px 10px;flex-shrink:0" @onclick="() => CopyAsync(_inviteLink)">Copy</button>
            </div>
            <div style="display:flex;justify-content:flex-end">
                <button class="ccn-btn" @onclick="() => _inviteLink = null">Done</button>
            </div>
        </div>
    </div>
}

@code {
    private List<User> _users = new();
    private Event? _activeEvent;
    private bool _loading = true;
    private bool _mobileFormOpen;
    private UserForm _form = new();

    private bool _editOpen;
    private User? _editing;
    private EditUserForm _editForm = new();
    private string? _editError;

    private bool _resetOpen;
    private User? _resetting;
    private string _resetPassword = "";
    private string _resetConfirm = "";
    private string? _resetError;
    private bool _linkBusy;
    private string? _resetLinkStatus;
    private string? _resetLink;
    private string? _inviteLink;
    private string _inviteNote = "";

    private bool _showCreatePw;
    private bool _showResetPw;
    private bool _showResetConfirm;

    private string _search = "";
    private string _roleFilter = "";
    private string _sortColumn = "role";
    private bool _sortAsc = true;

    private static int RoleRank(string systemName) => systemName switch
    {
        "Admin"        => 0,
        "MedicalStaff" => 1,
        "Staff"        => 2,
        _              => 3
    };

    private IEnumerable<User> FilteredUsers
    {
        get
        {
            var q = _users.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_search))
                q = q.Where(u =>
                    u.FirstName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    u.LastName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_roleFilter))
                q = q.Where(u => u.UserRole.SystemName == _roleFilter);
            return _sortColumn switch
            {
                "name" => _sortAsc
                    ? q.OrderBy(u => u.LastName).ThenBy(u => u.FirstName)
                    : q.OrderByDescending(u => u.LastName).ThenByDescending(u => u.FirstName),
                _ => _sortAsc
                    ? q.OrderBy(u => RoleRank(u.UserRole.SystemName)).ThenBy(u => u.LastName).ThenBy(u => u.FirstName)
                    : q.OrderByDescending(u => RoleRank(u.UserRole.SystemName)).ThenBy(u => u.LastName).ThenBy(u => u.FirstName)
            };
        }
    }

    private void SetSort(string col)
    {
        if (_sortColumn == col) _sortAsc = !_sortAsc;
        else { _sortColumn = col; _sortAsc = true; }
    }

    private string SortIndicator(string col) =>
        _sortColumn == col ? (_sortAsc ? "▲" : "▼") : "";

    protected override async Task OnInitializedAsync()
    {
        _activeEvent = await ActiveEventSvc.GetActiveEventAsync();
        _users  = await AuthSvc.GetAllUsersAsync();
        _form = NewForm();
        _loading = false;
    }

    // Invite by default once email is configured; before that, keep today's temporary-password flow.
    private UserForm NewForm() => new() { SendInvite = Email.IsConfigured };

    private void CloseCreateOverlay() { _mobileFormOpen = false; _form = NewForm(); }

    private string BaseUrl => PublicBaseUrl.From(Nav.BaseUri, Config);

    private async Task<Guid> CurrentAdminIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Email)) return;
        if (!_form.SendInvite && string.IsNullOrWhiteSpace(_form.Password)) return;
        var name = $"{_form.FirstName} {_form.LastName}".Trim();

        if (_form.SendInvite)
        {
            // The invitee sets their own password from the link; this one is never shown or used.
            var user = await AuthSvc.CreateUserAsync(_form.FirstName, _form.LastName, _form.Email,
                PasswordResetService.RandomPassword(), _form.Role, mustChangePassword: false);
            await AddToEventStaffAsync(user);
            var result = await Resets.SendInviteAsync(user.UserId, await CurrentAdminIdAsync(), BaseUrl);
            if (result.Emailed)
                Snackbar.Add($"Account created. Invite emailed to {user.Email}.", Severity.Success);
            else
            {
                _inviteNote = Email.IsConfigured
                    ? $"Account created for {name}, but the invite email couldn't be sent. Send them this link (valid 7 days):"
                    : $"Account created for {name}. Email isn't set up yet, so send them this link yourself (valid 7 days):";
                _inviteLink = result.Link;
            }
        }
        else
        {
            var user = await AuthSvc.CreateUserAsync(_form.FirstName, _form.LastName, _form.Email, _form.Password, _form.Role);
            await AddToEventStaffAsync(user);
            Snackbar.Add($"Account created for {name}.", Severity.Success);
        }

        _mobileFormOpen = false;
        _form = NewForm();
        _users = await AuthSvc.GetAllUsersAsync();
    }

    private async Task AddToEventStaffAsync(User user)
    {
        if (_form.AddToEventStaff && _activeEvent is not null)
            await EventStaffSvc.AddAsync(_activeEvent.EventId, user.UserId, user.UserRoleId);
    }

    private async Task SendResetLinkAsync()
    {
        if (_resetting is null) return;
        _linkBusy = true;
        var result = await Resets.SendAdminResetAsync(_resetting.UserId, await CurrentAdminIdAsync(), BaseUrl);
        _linkBusy = false;
        if (result.Emailed)
        {
            _resetLinkStatus = $"✓ Sent to {_resetting.Email}.";
            _resetLink = null;
        }
        else
        {
            _resetLinkStatus = Email.IsConfigured
                ? "The email couldn't be sent. Send them this link instead:"
                : "Email isn't set up yet. Send them this link yourself:";
            _resetLink = result.Link;
        }
    }

    private async Task CopyAsync(string? text)
    {
        if (text is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Link copied.", Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add("Couldn't copy — select the link and copy it manually.", Severity.Warning);
        }
    }

    private void OpenEditDialog(User u)
    {
        _editing = u;
        _editForm = new EditUserForm
        {
            FirstName = u.FirstName,
            LastName  = u.LastName,
            Email     = u.Email,
            Role      = Enum.TryParse<Role>(u.UserRole.SystemName, out var r) ? r : Role.Staff
        };
        _editError = null;
        _editOpen = true;
    }

    private void CloseEditDialog()
    {
        _editOpen = false;
        _editing = null;
    }

    private async Task SubmitEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editForm.FirstName) || string.IsNullOrWhiteSpace(_editForm.Email))
        {
            _editError = "First name and email are required.";
            return;
        }
        await AuthSvc.UpdateUserAsync(_editing!.UserId, _editForm.FirstName, _editForm.LastName, _editForm.Email, _editForm.Role);
        Snackbar.Add($"{_editForm.FirstName} {_editForm.LastName} updated.", Severity.Success);
        _users = await AuthSvc.GetAllUsersAsync();
        CloseEditDialog();
    }

    private void OpenResetDialog(User u)
    {
        _resetting = u;
        _resetPassword = "";
        _resetConfirm = "";
        _resetError = null;
        _showResetPw = false;
        _showResetConfirm = false;
        _resetLinkStatus = null;
        _resetLink = null;
        _resetOpen = true;
    }

    private void CloseResetDialog()
    {
        _resetOpen = false;
        _resetting = null;
        _showResetPw = false;
        _showResetConfirm = false;
    }

    private async Task SubmitResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _resetError = "Password cannot be empty.";
            return;
        }
        if (_resetPassword != _resetConfirm)
        {
            _resetError = "Passwords do not match.";
            return;
        }
        await AuthSvc.ResetPasswordAsync(_resetting!.UserId, _resetPassword);
        Snackbar.Add($"Password reset for {_resetting.FirstName} {_resetting.LastName}.", Severity.Success);
        CloseResetDialog();
    }

    private async Task DeactivateAsync(User u)
    {
        var result = await DialogService.ShowMessageBox("Deactivate User",
            $"Deactivate {u.FirstName} {u.LastName}? They will no longer be able to sign in.",
            yesText: "Deactivate", cancelText: "Cancel");
        if (result != true) return;
        await AuthSvc.DeactivateUserAsync(u.UserId);
        _users = await AuthSvc.GetAllUsersAsync();
        Snackbar.Add($"{u.FirstName} {u.LastName} deactivated.", Severity.Info);
    }

    private class UserForm
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public Role Role { get; set; } = Role.Staff;
        public bool SendInvite { get; set; }
        public bool AddToEventStaff { get; set; } = true;
    }

    private class EditUserForm
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public Role Role { get; set; } = Role.Staff;
    }
}

@page "/admin/events"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ActiveEventService ActiveEventSvc
@inject CapabilityService CapSvc
@inject EventSetupService EventSetup
@using CampClotNot.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>Events — Camp Clot Not</PageTitle>

<style>
    @@media (max-width: 699px) {
        .admin-evt-form  { display: none; }
        .admin-evt-table { display: none; }
        .admin-evt-cards { display: flex; flex-direction: column; gap: 10px; }
        .admin-evt-add-mobile { display: block; margin-bottom: 12px; }
    }
    @@media (min-width: 700px) {
        .admin-evt-cards { display: none; }
        .admin-evt-add-mobile { display: none; }
    }
</style>

<div style="padding: 0 16px 100px">
    <h2 style="font-family:var(--font-display);font-weight:700;font-size:22px;margin:0 0 20px"><img src="/img/icons/gear.svg?v=3" style="width:20px;height:20px;vertical-align:middle;margin-right:6px;opacity:.8" alt="" />Events</h2>

    <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">

        <div style="@(_mobileFormOpen ? "position:fixed;inset:0;background:rgba(26,26,26,.65);z-index:100;overflow-y:auto;display:flex;align-items:flex-start;justify-content:center;padding:16px;animation:fadeIn .15s ease" : "display:contents")"
             @onclick="CloseFormOverlay">
        <div class="admin-evt-form" style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:@(_mobileFormOpen ? "8px 8px 0 var(--border-color)" : "4px 4px 0 var(--border-color)");padding:20px;flex:0 0 320px;min-width:260px;@(_mobileFormOpen ? "display:block !important;max-width:480px;width:100%;margin:auto;animation:popIn .2s ease" : "")"
             @onclick:stopPropagation>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
                <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0">@(_editingId == Guid.Empty ? "Create Event" : "Edit Event")</h3>
                @if (_mobileFormOpen)
                {
                    <button @onclick="CloseFormOverlay" style="background:none;border:none;font-size:22px;cursor:pointer;line-height:1;color:var(--text-light);padding:0">✕</button>
                }
            </div>

            @if (_editingId == Guid.Empty && _events.Any())
            {
                <div style="margin-bottom:14px;padding:12px;background:var(--bg-base);border:2px dashed var(--border-color);border-radius:8px">
                    <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Copy setup from</div>
                    <select value="@(_copyFromId?.ToString() ?? "")" @onchange="OnCopyFromChanged"
                            style="width:100%;padding:9px 12px;background:var(--panel-bg);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;cursor:pointer">
                        <option value="">None — start fresh</option>
                        @foreach (var ev in _events)
                        {
                            <option value="@ev.EventId">@ev.Name</option>
                        }
                    </select>
                    @if (_copyFromId is not null && _copyCounts is not null)
                    {
                        <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin:10px 0 5px">Also copy</div>
                        <label style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;cursor:pointer">
                            <input type="checkbox" checked="@_copySponsors" @onchange="() => _copySponsors = !_copySponsors" /> Sponsors (@_copyCounts.Sponsors)
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;cursor:pointer">
                            <input type="checkbox" checked="@_copyStaff" @onchange="() => _copyStaff = !_copyStaff" /> Staff directory (@_copyCounts.StaffDirectory)
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;cursor:pointer">
                            <input type="checkbox" checked="@_copyEventStaff" @onchange="() => _copyEventStaff = !_copyEventStaff" /> Event staff (@_copyCounts.EventStaff) <span style="font-weight:600;color:var(--text-light)">— people and roles, not groups</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;cursor:pointer">
                            <input type="checkbox" checked="@_copyActivities" @onchange="() => _copyActivities = !_copyActivities" /> Activities (@_copyCounts.Activities)
                        </label>
                        <div style="font-size:11px;color:var(--text-light);margin-top:6px">Capabilities (below) and enabled schedule item types are always copied. Groups, schedule items, announcements, and documents aren't. Locations and info pages are shared by all events.</div>
                    }
                </div>
            }

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Event Name *</div>
                <input type="text" @bind="_fName" placeholder="e.g. Men's Retreat 2026"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Start Date *</div>
                <input type="date" value="@_fStartDate?.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _fStartDate = d; }"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">End Date *</div>
                <input type="date" value="@_fEndDate?.ToString("yyyy-MM-dd")"
                       @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _fEndDate = d; }"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box" />
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Event Type</div>
                <div style="display:flex;gap:6px;align-items:stretch">
                    <select value="@_fEventTypeId.ToString()"
                            @onchange="e => _fEventTypeId = Guid.TryParse(e.Value?.ToString(), out var v) ? v : _eventTypes.First().EventTypeId"
                            style="flex:1;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;cursor:pointer">
                        @foreach (var et in _eventTypes)
                        {
                            <option value="@et.EventTypeId">@et.Name</option>
                        }
                    </select>
                    <button class="ccn-btn" style="font-size:11px;padding:6px 10px;flex-shrink:0" @onclick="() => _showNewType = !_showNewType">+</button>
                </div>
                @if (_showNewType)
                {
                    <div style="display:flex;gap:6px;margin-top:8px;align-items:stretch">
                        <input type="text" @bind="_newTypeName" placeholder="e.g. Men's Retreat"
                               style="flex:1;padding:7px 10px;background:var(--bg-base);border:2px solid var(--border-color);border-radius:6px;font-size:13px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);outline:none;box-sizing:border-box" />
                        <button class="ccn-btn" style="font-size:11px;padding:6px 10px;flex-shrink:0" disabled="@string.IsNullOrWhiteSpace(_newTypeName)" @onclick="AddEventTypeAsync">Add</button>
                    </div>
                }
            </div>

            <div style="margin-bottom:14px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Theme</div>
                @if (_editingId == Guid.Empty)
                {
                    <select value="@_fThemeStart" @onchange="e => _fThemeStart = e.Value?.ToString() ?? _fThemeStart"
                            style="width:100%;padding:9px 12px;background:var(--bg-base);border:var(--panel-border);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--border-color);outline:none;box-sizing:border-box;cursor:pointer">
                        @if (_copyFromId is { } srcId)
                        {
                            <option value="@SourceThemeKey">Same as @(_events.FirstOrDefault(e => e.EventId == srcId)?.Name)</option>
                        }
                        @foreach (var p in ThemePresets.All)
                        {
                            <option value="@p.Key">Start from @p.Name</option>
                        }
                    </select>
                    <div style="font-size:11px;color:var(--text-light);margin-top:4px">Each event gets its own theme. Customize colors and upload a logo on the Theme page after creating.</div>
                }
                else
                {
                    <a class="ccn-btn" style="display:inline-block;font-size:11px;padding:6px 10px;text-decoration:none"
                       href="/admin/theme?eventId=@_editingId">Edit theme →</a>
                }
            </div>

            <div style="margin-bottom:16px">
                <div style="display:flex;align-items:center;gap:8px">
                    <input type="checkbox" checked="@_fIsActive" @onchange="() => _fIsActive = !_fIsActive" />
                    <span style="font-size:13px;font-family:'Nunito',sans-serif;font-weight:600">Active event</span>
                </div>
                <div style="font-size:11px;color:var(--text-light)">Only one event should be active at a time. Setting this active will deactivate others.</div>
            </div>

            <div style="margin-bottom:16px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:5px">Guest Code</div>
                <input type="text" @bind="_fGuestCode" placeholder="e.g. MENSRETREAT26"
                       style="width:100%;padding:9px 12px;background:var(--bg-base);border:3px solid var(--black);border-radius:7px;font-size:14px;font-family:'Nunito',sans-serif;font-weight:600;color:var(--text-dark);box-shadow:2px 2px 0 var(--black);outline:none;box-sizing:border-box;text-transform:uppercase" />
                <div style="font-size:11px;color:var(--text-light);margin-top:4px">Attendees scan a QR code or type this to reach a read-only Schedule/Announcements view. Leave blank to disable guest access for this event.</div>
                @if (_editingId != Guid.Empty && !string.IsNullOrWhiteSpace(_fGuestCode))
                {
                    <a class="ccn-btn" style="display:inline-block;margin-top:8px;font-size:11px;padding:6px 10px;text-decoration:none"
                       href="/admin/events/@_editingId/guest-qr" target="_blank">Generate QR</a>
                }
            </div>

            <div style="margin-bottom:16px">
                <div style="font-size:10px;font-weight:900;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-light);margin-bottom:8px">Capabilities</div>
                @foreach (var cap in _allCapabilities)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                        <input type="checkbox" checked="@_fEnabledCapIds.Contains(cap.CapabilityId)" @onchange="() => ToggleCapability(cap.CapabilityId)" />
                        <span style="font-size:13px;font-family:'Nunito',sans-serif;font-weight:600">@cap.Name</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div style="color:#D12B2B;font-size:12px;margin-bottom:10px">@_saveError</div>
            }

            <div style="display:flex;gap:8px">
                <button class="ccn-btn" @onclick="SaveAsync">@(_editingId == Guid.Empty ? "Create Event" : "Save Changes")</button>
                @if (_editingId != Guid.Empty)
                {
                    <button class="ccn-btn" style="background:transparent" @onclick="ResetForm">Cancel</button>
                }
            </div>
        </div>
        </div>

        <div style="flex:1;min-width:240px">
            <button class="ccn-btn admin-evt-add-mobile" @onclick="() => _mobileFormOpen = true">+ Create Event</button>

            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (!_events.Any())
            {
                <p style="color:var(--text-light);font-family:var(--font-display);font-weight:700">No events yet. Create the first one →</p>
            }
            else
            {
                <div class="admin-evt-cards">
                    @foreach (var ev in _events)
                    {
                        <div style="background:var(--panel-bg);border:var(--panel-border);border-radius:10px;box-shadow:3px 3px 0 var(--border-color);padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:8px">
                            <div style="flex:1;min-width:0">
                                <div style="display:flex;align-items:center;gap:6px">
                                    <div style="font-family:var(--font-display);font-weight:700;font-size:14px;color:var(--text-dark)">@ev.Name</div>
                                    @if (ev.IsActive) { <span style="font-size:9px;font-weight:800;background:#27AE60;color:white;padding:2px 6px;border-radius:3px">ACTIVE</span> }
                                </div>
                                <div style="font-size:11px;color:var(--text-light)">@ev.EffDate.ToString("MMM d") – @ev.ExpDate.ToString("MMM d, yyyy")</div>
                            </div>
                            <div style="display:flex;gap:6px;flex-shrink:0">
                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="async () => { await StartEdit(ev); _mobileFormOpen = true; }">Edit</button>
                                <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:transparent" @onclick="async () => { await StartDuplicate(ev); _mobileFormOpen = true; }">Duplicate</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="admin-evt-table" style="border:var(--panel-border);border-radius:10px;box-shadow:4px 4px 0 var(--border-color);overflow:hidden">
                    <table style="width:100%;border-collapse:collapse">
                        <thead>
                            <tr style="background:var(--black)">
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Name</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Type</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Dates</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Status</th>
                                <th style="padding:10px 14px;color:white;font-family:var(--font-display);font-weight:700;font-size:12px;text-align:left">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in _events)
                            {
                                <tr style="border-bottom:2px solid #E8E0CC">
                                    <td style="padding:10px 14px;font-size:13px;font-weight:700">@ev.Name</td>
                                    <td style="padding:10px 14px;font-size:12px;color:var(--text-mid)">@ev.EventType.Name</td>
                                    <td style="padding:10px 14px;font-size:12px;color:var(--text-mid)">@ev.EffDate.ToString("MMM d") – @ev.ExpDate.ToString("MMM d, yyyy")</td>
                                    <td style="padding:10px 14px">
                                        @if (ev.IsActive)
                                        {
                                            <span style="font-size:10px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:white;background:#27AE60;padding:2px 8px;border-radius:4px;border:2px solid var(--border-color)">Active</span>
                                        }
                                        else
                                        {
                                            <span style="font-size:10px;font-weight:800;color:var(--text-light)">Inactive</span>
                                        }
                                    </td>
                                    <td style="padding:8px 10px">
                                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                                            <button class="ccn-btn" style="font-size:11px;padding:4px 10px" @onclick="() => StartEdit(ev)">Edit</button>
                                            <button class="ccn-btn" style="font-size:11px;padding:4px 10px;background:transparent" @onclick="() => StartDuplicate(ev)">Duplicate</button>
                                            <a class="ccn-btn" style="font-size:11px;padding:4px 10px;text-decoration:none;background:transparent" href="/admin/theme?eventId=@ev.EventId">Theme</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _loading = true;
    private bool _mobileFormOpen;
    private List<Event> _events = new();
    private List<EventType> _eventTypes = new();

    private Guid _editingId;
    private string _fName = "";
    private DateOnly? _fStartDate;
    private DateOnly? _fEndDate;
    private Guid _fEventTypeId;
    // "Start from" for a new event's theme: a preset key, or SourceThemeKey to copy the source event's theme.
    private const string SourceThemeKey = "source";
    private string _fThemeStart = ThemePresets.Classic.Key;
    private Guid? _copyFromId;
    private CopyCounts? _copyCounts;
    private bool _copySponsors;
    private bool _copyStaff;
    private bool _copyActivities;
    private bool _copyEventStaff = true;
    private bool _fIsActive;
    private string _fGuestCode = "";
    private List<Capability> _allCapabilities = new();
    private HashSet<Guid> _fEnabledCapIds = new();
    private string _saveError = "";
    private bool _showNewType;
    private string _newTypeName = "";

    // New events default to only the non-game-specific capabilities on (Announcements, Itinerary).
    // Board Game, Coin Shop, Mini-Game Spinner, Bowser Event, and Awards are Mario-camp-specific
    // and must be explicitly turned on per event rather than requiring an admin to uncheck them.
    private static readonly HashSet<string> DefaultEnabledCapabilitySystemNames = new() { "Announcements", "Itinerary" };

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _fEnabledCapIds = _allCapabilities.Where(c => DefaultEnabledCapabilitySystemNames.Contains(c.SystemName)).Select(c => c.CapabilityId).ToHashSet();
        _loading = false;
    }

    private async Task Reload()
    {
        using var db = DbFactory.CreateDbContext();
        _events = await db.Events.Include(e => e.EventType).OrderByDescending(e => e.EffDate).ToListAsync();
        _eventTypes = await db.EventTypes.ToListAsync();
        _allCapabilities = await db.Capabilities.OrderBy(c => c.Name).ToListAsync();
        if (_fEventTypeId == Guid.Empty && _eventTypes.Any())
            _fEventTypeId = _eventTypes.First().EventTypeId;
    }

    private async Task StartEdit(Event ev)
    {
        _editingId = ev.EventId;
        _fName = ev.Name;
        _fStartDate = ev.EffDate;
        _fEndDate = ev.ExpDate;
        _fEventTypeId = ev.EventTypeId;
        _fIsActive = ev.IsActive;
        _fGuestCode = ev.GuestCode ?? "";
        _saveError = "";
        var enabled = await CapSvc.GetEnabledCapabilitiesAsync(ev.EventId);
        _fEnabledCapIds = enabled.Select(c => c.CapabilityId).ToHashSet();
    }

    private void ResetForm()
    {
        _editingId = Guid.Empty;
        _fName = "";
        _fStartDate = null;
        _fEndDate = null;
        _fIsActive = false;
        _fGuestCode = "";
        _saveError = "";
        _fEnabledCapIds = _allCapabilities.Where(c => DefaultEnabledCapabilitySystemNames.Contains(c.SystemName)).Select(c => c.CapabilityId).ToHashSet();
        if (_eventTypes.Any()) _fEventTypeId = _eventTypes.First().EventTypeId;
        _fThemeStart = ThemePresets.Classic.Key;
        _copyFromId = null;
        _copyCounts = null;
        _copySponsors = _copyStaff = _copyActivities = false;
        _copyEventStaff = true;
    }

    private async Task AddEventTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTypeName)) return;
        using var db = DbFactory.CreateDbContext();
        var name = _newTypeName.Trim();
        var systemName = System.Text.RegularExpressions.Regex.Replace(name, @"[^A-Za-z0-9]", "");
        var newType = new EventType
        {
            EventTypeId = Guid.NewGuid(),
            Name = name,
            Description = name,
            SystemName = systemName
        };
        db.EventTypes.Add(newType);
        await db.SaveChangesAsync();
        _eventTypes.Add(newType);
        _fEventTypeId = newType.EventTypeId;
        _newTypeName = "";
        _showNewType = false;
    }

    private void ToggleCapability(Guid capabilityId)
    {
        if (!_fEnabledCapIds.Add(capabilityId))
            _fEnabledCapIds.Remove(capabilityId);
    }

    private async Task OnCopyFromChanged(ChangeEventArgs e) =>
        await SetCopySourceAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private async Task SetCopySourceAsync(Guid? sourceId)
    {
        _copyFromId = sourceId;
        _copySponsors = _copyStaff = _copyActivities = false;
        _copyEventStaff = true;
        if (sourceId is { } src)
        {
            _copyCounts = await EventSetup.GetCopyCountsAsync(src);
            var enabled = await CapSvc.GetEnabledCapabilitiesAsync(src);
            _fEnabledCapIds = enabled.Select(c => c.CapabilityId).ToHashSet();
            _fThemeStart = SourceThemeKey;
        }
        else
        {
            _copyCounts = null;
            _fEnabledCapIds = _allCapabilities.Where(c => DefaultEnabledCapabilitySystemNames.Contains(c.SystemName)).Select(c => c.CapabilityId).ToHashSet();
            _fThemeStart = ThemePresets.Classic.Key;
        }
    }

    private async Task StartDuplicate(Event ev)
    {
        ResetForm();
        _fEventTypeId = ev.EventTypeId;
        await SetCopySourceAsync(ev.EventId);
    }

    private void CloseFormOverlay()
    {
        _mobileFormOpen = false;
        if (_editingId != Guid.Empty) ResetForm();
    }

    private async Task SaveAsync()
    {
        _saveError = "";
        if (string.IsNullOrWhiteSpace(_fName) || _fStartDate is null || _fEndDate is null)
        {
            _saveError = "Name, start date, and end date are required.";
            return;
        }
        if (_fEndDate < _fStartDate)
        {
            _saveError = "End date must be after start date.";
            return;
        }

        if (_editingId == Guid.Empty)
        {
            try
            {
                await EventSetup.CreateAsync(new NewEventRequest(
                    _fName, _fStartDate.Value, _fEndDate.Value, _fEventTypeId, _fIsActive, _fGuestCode,
                    _fEnabledCapIds,
                    ThemePresetKey: _copyFromId is not null && _fThemeStart == SourceThemeKey ? null : _fThemeStart,
                    CopyFromEventId: _copyFromId,
                    Copy: new EventCopyOptions(_copySponsors, _copyStaff, _copyActivities, _copyEventStaff)));
            }
            catch (InvalidOperationException ex)
            {
                _saveError = ex.Message;
                return;
            }
            ResetForm();
            _mobileFormOpen = false;
            await Reload();
            return;
        }

        using var db = DbFactory.CreateDbContext();

        if (!string.IsNullOrWhiteSpace(_fGuestCode))
        {
            var normalized = _fGuestCode.Trim().ToUpperInvariant();
            var codeTaken = await db.Events.AnyAsync(e => e.GuestCode == normalized && e.EventId != _editingId);
            if (codeTaken)
            {
                _saveError = "That guest code is already used by another event.";
                return;
            }
        }

        if (!_fIsActive && _editingId != Guid.Empty)
        {
            var editingIsCurrentlyActive = await db.Events.Where(e => e.EventId == _editingId).Select(e => e.IsActive).FirstOrDefaultAsync();
            if (editingIsCurrentlyActive)
            {
                var anotherEventIsActive = await db.Events.AnyAsync(e => e.IsActive && e.EventId != _editingId);
                if (!anotherEventIsActive)
                {
                    _saveError = "At least one event must stay active. Activate another event before deactivating this one.";
                    return;
                }
            }
        }

        if (_fIsActive)
        {
            var others = await db.Events.Where(e => e.IsActive && e.EventId != _editingId).ToListAsync();
            foreach (var o in others) o.IsActive = false;
        }

        var targetEventId = _editingId;
        var existing = await db.Events.FindAsync(_editingId);
        if (existing is not null)
        {
            existing.Name = _fName.Trim();
            existing.EffDate = _fStartDate.Value;
            existing.ExpDate = _fEndDate.Value;
            existing.EventTypeId = _fEventTypeId;
            existing.IsActive = _fIsActive;
            existing.GuestCode = string.IsNullOrWhiteSpace(_fGuestCode) ? null : _fGuestCode.Trim().ToUpperInvariant();
        }

        await db.SaveChangesAsync();

        foreach (var cap in _allCapabilities)
            await CapSvc.SetEventCapabilityAsync(targetEventId, cap.CapabilityId, _fEnabledCapIds.Contains(cap.CapabilityId));

        ActiveEventSvc.InvalidateCache();
        ResetForm();
        _mobileFormOpen = false;
        await Reload();
    }
}

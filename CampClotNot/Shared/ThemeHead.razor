@* Injects CSS custom properties for the active theme into :root.
   Include this component in every layout so all pages get the vars.
   Components use var(--color-primary) etc. instead of hardcoded hex. *@
@inject ThemeService ThemeSvc

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Poppins:wght@600;700&family=Nunito:wght@400;600;700;800;900&display=swap');

    :root {
        @((MarkupString)ThemeSvc.Active.CssVariables)
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
        font-family: 'Nunito', sans-serif;
        background-color: var(--bg-base);
        background-image: var(--bg-dot-image);
        background-size: 22px 22px;
        color: var(--text-dark);
    }

    /* ── Shared panel — border/shadow shape (thick offset vs. thin+soft) is theme-driven ── */
    .ccn-panel {
        background: var(--panel-bg);
        border: var(--panel-border);
        border-radius: 10px;
        box-shadow: var(--panel-shadow);
    }

    /* ── Shared button ── */
    .ccn-btn {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 13px;
        letter-spacing: .4px;
        padding: 9px 18px;
        border-radius: 7px;
        border: var(--panel-border);
        cursor: pointer;
        box-shadow: var(--panel-shadow);
        transition: transform .12s ease, filter .12s ease;
        color: var(--text-dark);
        background: var(--panel-bg);
    }
    .ccn-btn:hover  { transform: translateY(-2px); filter: brightness(1.05); }
    .ccn-btn:active { transform: translateY(1px);  filter: brightness(0.95); }
    .ccn-btn:disabled { opacity: .45; cursor: not-allowed; transform: none; filter: none; }

    /* ── Rank rows ── */
    .ccn-rank-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: var(--border-width) solid var(--border-color);
    }
    .ccn-rank-row:last-child { border-bottom: none; }

    /* ── Section label ── */
    .ccn-section-label {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--text-light);
        margin-bottom: 10px;
    }

    /* ── Animations ── */
    @@keyframes popIn    { 0%{transform:scale(.65) translateY(14px);opacity:0} 70%{transform:scale(1.08)} 100%{transform:scale(1);opacity:1} }
    @@keyframes slideUp  { from{transform:translateY(16px);opacity:0} to{transform:translateY(0);opacity:1} }
    @@keyframes shake    { 0%,100%{transform:rotate(0)} 20%{transform:rotate(-8deg)} 40%{transform:rotate(8deg)} 60%{transform:rotate(-5deg)} 80%{transform:rotate(4deg)} }
    @@keyframes rollFlip   { from{transform:translateY(-10px);opacity:0} to{transform:translateY(0);opacity:1} }
    @@keyframes blockBounce { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-12px) scale(1.05)} }
    @@keyframes fadeIn   { from{opacity:0} to{opacity:1} }
    @@keyframes blockPulse { from{box-shadow:3px 3px 0 var(--black)} to{box-shadow:6px 6px 0 var(--black),0 0 0 3px var(--color-primary)} }
    @@keyframes bounce   { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)} }
    @@keyframes pulseBorder { 0%,100%{opacity:.5} 50%{opacity:1} }

    /* FAB clears the bottom nav bar on mobile */
    @@media (max-width: 1023px) {
        .ccn-fab-mobile { bottom: calc(72px + env(safe-area-inset-bottom)) !important; }
    }
    @@media (max-width: 768px) {
        .ccn-push-banner { display: flex !important; }
    }

    /* ── MudTabs override — border/shadow/font all theme-driven ── */
    .mud-tabs {
        border: var(--panel-border);
        border-radius: 10px;
        box-shadow: var(--panel-shadow);
        overflow: hidden;
    }
    .mud-tabs-header {
        background: var(--panel-bg) !important;
        border-bottom: var(--border-width) solid var(--border-color) !important;
    }
    .mud-tabs-header .mud-tab {
        font-family: var(--font-display) !important;
        font-weight: 700 !important;
        font-size: 13px !important;
        color: var(--text-mid) !important;
        opacity: 1 !important;
        transition: color .15s, background-color .15s !important;
    }
    .mud-tabs-header .mud-tab:hover {
        background-color: rgba(26,26,26,0.05) !important;
        color: var(--text-dark) !important;
    }
    .mud-tabs-header .mud-tab.mud-tab-active {
        color: var(--text-dark) !important;
        background-color: var(--bg-base) !important;
    }
    .mud-tab-slider {
        background: var(--border-color) !important;
        background-color: var(--border-color) !important;
        height: 4px !important;
    }
    .mud-tabs-panels {
        background: var(--panel-bg) !important;
    }
</style>

@code {
    protected override async Task OnInitializedAsync() => await ThemeSvc.LoadAsync();
}

@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ThemeService ThemeSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject GuestAccessService GuestSvc
@inject IConfiguration Config
@implements IDisposable

<ThemeHead />
<MudThemeProvider IsDarkMode="false" Theme="@BuildMudTheme()" />
<MudDialogProvider />
<MudSnackbarProvider />

<ProjectorOverlay Visible="_showProjector" OnClose="@(() => _showProjector = false)" />

@* App shell (#326): on phones the page itself doesn't scroll — header, .app-main, bottom bar
   are a fixed-height flex column (app.css), so iOS can't drag the header or shift the bar.
   Ui:AppShell=false drops the classes and restores the old document-scrolling layout. *@
<div class="@(_appShell ? "app-frame" : null)">

@if (_isGuest)
{
    <GuestNav />
}
else
{
    <AppNav OnLeaderboardClick="@(() => _showProjector = true)" />
}

@if (_showPushBanner)
{
    <div class="ccn-push-banner" style="position:fixed;top:0;left:0;right:0;z-index:100;background:var(--color-primary);border-bottom:3px solid var(--black);padding:calc(10px + env(safe-area-inset-top)) 16px 10px;display:none;align-items:center;justify-content:space-between;gap:10px;animation:fadeIn .2s ease">
        <span style="font-family:var(--font-display);font-size:13px;color:var(--text-dark)">Enable notifications to get camp announcements</span>
        <div style="display:flex;gap:6px;flex-shrink:0">
            <button class="ccn-btn" style="font-size:11px;padding:5px 12px" @onclick="EnablePush">Enable</button>
            <button style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--black);line-height:1" @onclick="() => _showPushBanner = false">✕</button>
        </div>
    </div>
}

<div class="@(_appShell ? "app-main" : null)">
    <div class="app-content">
        @Body
    </div>
</div>

<InstallPromptBanner />
</div>

@code {
    private bool _showProjector;
    private bool _showPushBanner;
    private bool _isGuest;
    private bool _appShell;
    private string _path = "";

    protected override async Task OnInitializedAsync()
    {
        _appShell = Config.GetValue("Ui:AppShell", true);
        _path = new Uri(Nav.Uri).AbsolutePath;
        Nav.LocationChanged += OnLocationChanged;
        var state = await AuthState.GetAuthenticationStateAsync();
        _isGuest = GuestSvc.GetGuestEventId(state.User).HasValue;
        await ThemeSvc.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthState.GetAuthenticationStateAsync();
        if (!_isGuest && state.User.HasClaim("mustChangePassword", "true"))
            Nav.NavigateTo("/change-password", forceLoad: false);

        if (state.User.Identity?.IsAuthenticated == true)
        {
            try
            {
                var supported = await JS.InvokeAsync<bool>("ccnPush.isSupported");
                if (supported)
                {
                    var subscribed = await JS.InvokeAsync<bool>("ccnPush.isSubscribed");
                    if (!subscribed)
                    {
                        _showPushBanner = true;
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    // Blazor resets the window's scroll on navigation, but in the app shell the window never
    // scrolls — .app-main does — so a new page would open at the old page's scroll position.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = new Uri(e.Location).AbsolutePath;
        if (!_appShell || path == _path) return;
        _path = path;
        try { await JS.InvokeVoidAsync("ccnShell.scrollToTop"); } catch { }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private async Task EnablePush()
    {
        try
        {
            var result = await JS.InvokeAsync<bool>("ccnPush.subscribe");
            _showPushBanner = false;
        }
        catch { _showPushBanner = false; }
    }

    // Was a static field with hardcoded Mario colors — MudBlazor's own theme (dialogs,
    // snackbars, spinners, tabs) never picked up the active event's theme at all. Now
    // resolved per-render from ThemeSvc.Active, same as the CSS variables.
    private MudTheme BuildMudTheme()
    {
        var t = ThemeSvc.Active;
        return new MudTheme
        {
            Palette = new Palette
            {
                Primary          = t.Primary,
                Secondary        = t.Accent,
                Success          = t.Success,
                Info             = t.Info,
                Background       = t.BgBase,
                Surface          = t.PanelBg,
                DrawerBackground = t.PanelBg,
                TextPrimary      = t.TextDark,
                TextSecondary    = t.TextMid,
                AppbarBackground = "#1A1A1A",   // matches --black, constant across themes
                AppbarText       = t.Primary,
            }
        };
    }
}
